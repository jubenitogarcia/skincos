{
  "schemaVersion": 1,
  "contractId": "skincos/cloudflare-single-writer/v1",
  "authority": {
    "provider": "github-actions",
    "coordinationPlane": "global",
    "mode": "fail-closed",
    "mutationProof": "remote-fenced-lease-revalidated-before-each-cloudflare-mutation",
    "unknownSurface": "deny",
    "automaticPagesDeployments": "disabled"
  },
  "retiredWorkflows": [
    ".github/workflows/ponto-core-baseline-publisher.yml"
  ],
  "nonPublishingWorkflows": [
    {
      "workflow": ".github/workflows/architecture-governance.yml",
      "reason": "Architecture governance invokes Cloudflare single-writer validation and synthetic mutation fixtures for inspection only; it has no publishing authority.",
      "requiredMarkers": [
        "validate-cloudflare-single-writer.mjs",
        "validate-cloudflare-single-writer.test.mjs"
      ]
    },
    {
      "workflow": ".github/workflows/timekeeping-ci.yml",
      "reason": "CI exercises local D1 and Wrangler dry-runs only; it has no publishing authority.",
      "requiredMarkers": [
        "--local",
        "--dry-run"
      ]
    },
    {
      "workflow": ".github/workflows/materialize-native-pilot-cohort-custody.yml",
      "reason": "Reads the pinned production identity through the D1 query endpoint to derive a GitHub environment secret; it has no Cloudflare mutation authority.",
      "requiredMarkers": [
        "/d1/database/${databaseId}/query",
        "SELECT",
        "PILOT_COHORT_IDENTITY_INVALID"
      ]
    },
    {
      "workflow": ".github/workflows/beauty-movement-delivery-export.yml",
      "reason": "Reads the active Beauty Movement campaign from D1 and derives a private delivery artifact; it has no Cloudflare mutation or deploy authority.",
      "requiredMarkers": [
        "beauty-movement:export-delivery",
        "SELECT c.status, c.ends_at_ms",
        "invite_token_hmac",
        "Upload private delivery artifact"
      ]
    }
  ],
  "coordinationGroups": [
    {
      "id": "crm-cloudflare-writer",
      "resource": "global:crm-cloudflare-writer",
      "purpose": "Serializes CRM Pages and the coupled CRM Worker secret/deploy workflows that can mutate the same project or credentials."
    },
    {
      "id": "ponto-workers-writer",
      "resource": "global:ponto-workers-writer",
      "purpose": "Serializes Ponto timekeeping, identity and core Worker publication/custody workflows."
    },
    {
      "id": "ponto-release-writer",
      "resource": "release:ponto",
      "purpose": "Serializes Ponto release-control, module-control, rollback and emergency Cloudflare mutations under the composite release authority."
    },
    {
      "id": "website-writer",
      "resource": "release:website",
      "purpose": "Compatibility writer group for Website Pages/Worker secrets, security configuration and Instagram R2 session state."
    },
    {
      "id": "finance-writer",
      "resource": "release:finance",
      "purpose": "Compatibility writer group for Finance Worker and its governed staging database operations."
    },
    {
      "id": "token-vault-writer",
      "resource": "release:token-vault",
      "purpose": "Serializes Token Vault Worker publication and its D1 migrations across isolated environments."
    },
    {
      "id": "finance-ui-writer",
      "resource": "deploy:finance-ui:<environment>",
      "purpose": "Dedicated Finance UI Pages projects; staging and production are isolated projects."
    },
    {
      "id": "ponto-waf-writer",
      "resource": "cloudflare:ponto-waf:production",
      "purpose": "Ponto WAF ruleset mutation authority."
    },
    {
      "id": "cloudflare-alerting-writer",
      "resource": "cloudflare:alerting:production",
      "purpose": "Cloudflare alerting ruleset mutation authority."
    },
    {
      "id": "staging-d1-writer",
      "resource": "global:staging-d1",
      "purpose": "Shared synthetic/staging D1 mutation authority."
    },
    {
      "id": "global-coordinator-writer",
      "resource": "global:global-coordinator-writer",
      "purpose": "Canonical bootstrap/update writer for the coordination plane itself; the one-time production bootstrap is allowed only before that endpoint exists, and every later update requires its remote lease."
    }
  ],
  "surfaces": [
    {
      "id": "crm-pages",
      "platform": "cloudflare-pages",
      "projects": ["skincos", "skincos-staging"],
      "canonicalDeployWorkflow": ".github/workflows/deploy-crm-pages.yml",
      "coordinationGroup": "crm-cloudflare-writer",
      "mutationWorkflows": [
        ".github/workflows/deploy-crm-pages.yml",
        ".github/workflows/cloudflare-pages-sync-ponto.yml",
        ".github/workflows/cloudflare-pages-sync-escala.yml",
        ".github/workflows/cloudflare-pages-sync-meta-ads-report-secret.yml",
        ".github/workflows/cloudflare-pages-sync-atendimento.yml",
        ".github/workflows/cloudflare-sync-integrations-encryption-secret.yml"
      ],
      "automaticDeploymentsRequired": false
    },
    {
      "id": "ponto-timekeeping-worker",
      "platform": "cloudflare-worker",
      "canonicalDeployWorkflow": ".github/workflows/deploy-timekeeping.yml",
      "coordinationGroup": "ponto-workers-writer",
      "mutationWorkflows": [
        ".github/workflows/deploy-timekeeping.yml",
        ".github/workflows/cloudflare-workers-sync-ponto-secrets.yml"
      ]
    },
    {
      "id": "ponto-core-and-identity-workers",
      "platform": "cloudflare-workers",
      "canonicalDeployWorkflow": ".github/workflows/deploy-core-workers.yml",
      "coordinationGroup": "ponto-workers-writer",
      "mutationWorkflows": [
        ".github/workflows/deploy-core-workers.yml",
        ".github/workflows/ponto-staging-core-provenance-recovery.yml",
        ".github/workflows/cloudflare-workers-sync-ponto-secrets.yml",
        ".github/workflows/insumos-production-smoke-identity.yml"
      ]
    },
    {
      "id": "escala-worker",
      "platform": "cloudflare-worker",
      "canonicalDeployWorkflow": ".github/workflows/deploy-escala-api.yml",
      "coordinationGroup": "crm-cloudflare-writer",
      "mutationWorkflows": [
        ".github/workflows/deploy-escala-api.yml",
        ".github/workflows/cloudflare-pages-sync-escala.yml"
      ]
    },
    {
      "id": "meta-ads-report-worker",
      "platform": "cloudflare-worker",
      "canonicalDeployWorkflow": ".github/workflows/deploy-meta-ads-report-worker.yml",
      "coordinationGroup": "crm-cloudflare-writer",
      "mutationWorkflows": [
        ".github/workflows/deploy-meta-ads-report-worker.yml",
        ".github/workflows/cloudflare-pages-sync-meta-ads-report-secret.yml"
      ]
    },
    {
      "id": "social-publisher-worker",
      "platform": "cloudflare-worker",
      "canonicalDeployWorkflow": ".github/workflows/deploy-social-publisher-worker.yml",
      "coordinationGroup": "crm-cloudflare-writer",
      "mutationWorkflows": [
        ".github/workflows/deploy-social-publisher-worker.yml",
        ".github/workflows/cloudflare-sync-integrations-encryption-secret.yml"
      ]
    },
    {
      "id": "website-pages-worker-and-r2",
      "platform": "cloudflare-pages-workers-r2",
      "canonicalDeployWorkflow": ".github/workflows/deploy-website-cloudflare.yml",
      "coordinationGroup": "website-writer",
      "mutationWorkflows": [
        ".github/workflows/deploy-website-cloudflare.yml",
        ".github/workflows/sync-website-cloudflare-security.yml",
        ".github/workflows/website-instagram-sync.yml",
        ".github/workflows/beauty-movement-staging-smoke.yml",
        ".github/workflows/beauty-movement-production-activation.yml",
        ".github/workflows/beauty-movement-short-links-sync.yml",
        ".github/workflows/beauty-movement-team-invite-links.yml",
        ".github/workflows/beauty-movement-campaign-copy-update.yml"
      ],
      "automaticDeploymentsRequired": false
    },
    {
      "id": "finance-worker-and-d1",
      "platform": "cloudflare-worker-d1",
      "canonicalDeployWorkflow": ".github/workflows/deploy-finance.yml",
      "coordinationGroup": "finance-writer",
      "mutationWorkflows": [
        ".github/workflows/deploy-finance.yml",
        ".github/workflows/finance-staging-canary.yml",
        ".github/workflows/finance-staging-smoke-identity.yml"
      ]
    },
    {
      "id": "token-vault-worker-and-d1",
      "platform": "cloudflare-worker-d1",
      "canonicalDeployWorkflow": ".github/workflows/deploy-token-vault.yml",
      "coordinationGroup": "token-vault-writer",
      "mutationWorkflows": [
        ".github/workflows/deploy-token-vault.yml",
        ".github/workflows/attest-meta-ads-candidate-appsecret.yml",
        ".github/workflows/influencer-intelligence-staging-shadow.yml"
      ]
    },
    {
      "id": "finance-ui-pages",
      "platform": "cloudflare-pages",
      "projects": ["skincos-finance-ui", "skincos-finance-ui-staging"],
      "canonicalDeployWorkflow": ".github/workflows/deploy-finance-ui.yml",
      "coordinationGroup": "finance-ui-writer",
      "mutationWorkflows": [".github/workflows/deploy-finance-ui.yml"],
      "automaticDeploymentsRequired": false
    },
    {
      "id": "ponto-waf",
      "platform": "cloudflare-waf",
      "canonicalDeployWorkflow": ".github/workflows/ponto-waf-security.yml",
      "coordinationGroup": "ponto-waf-writer",
      "mutationWorkflows": [".github/workflows/ponto-waf-security.yml"]
    },
    {
      "id": "cloudflare-alerting",
      "platform": "cloudflare-alerting",
      "canonicalDeployWorkflow": ".github/workflows/cloudflare-alerting-apply.yml",
      "coordinationGroup": "cloudflare-alerting-writer",
      "mutationWorkflows": [".github/workflows/cloudflare-alerting-apply.yml"]
    },
    {
      "id": "global-coordination-plane",
      "platform": "cloudflare-worker-durable-object",
      "canonicalDeployWorkflow": ".github/workflows/deploy-global-coordinator.yml",
      "coordinationGroup": "global-coordinator-writer",
      "mutationWorkflows": [".github/workflows/deploy-global-coordinator.yml", ".github/workflows/recover-global-coordinator.yml"],
      "exceptionalMutationWorkflows": [".github/workflows/recover-global-coordinator.yml"],
      "bootstrap": {
        "target": "production",
        "requires": ["main", "production-environment", "cloudflare-custody", "no-existing-production-endpoint"]
      }
    },
    {
      "id": "staging-d1-fixtures",
      "platform": "cloudflare-d1",
      "canonicalDeployWorkflow": ".github/workflows/insumos-staging-rbac-smoke.yml",
      "coordinationGroup": "staging-d1-writer",
      "mutationWorkflows": [
        ".github/workflows/insumos-staging-rbac-smoke.yml",
        ".github/workflows/timekeeping-staging-journey.yml",
        ".github/workflows/beauty-movement-staging-smoke.yml"
      ]
    },
    {
      "id": "ponto-release-control-plane",
      "platform": "cloudflare-ponto-release-control",
      "canonicalDeployWorkflow": ".github/workflows/ponto-progressive-release.yml",
      "coordinationGroup": "ponto-release-writer",
      "mutationWorkflows": [
        ".github/workflows/ponto-progressive-release.yml",
        ".github/workflows/ponto-release-watchdog.yml",
        ".github/workflows/ponto-emergency-close.yml",
        ".github/workflows/ponto-emergency-latch-reset.yml",
        ".github/workflows/module-availability.yml",
        ".github/workflows/ponto-staging-recovery-rollback.yml",
        ".github/workflows/ponto-staging-rollback-drill.yml"
      ]
    }
  ],
  "pagesGitIntegration": {
    "governedProjects": ["skincos", "skincos-staging", "skincos-finance-ui", "skincos-finance-ui-staging"],
    "connectionMayExist": true,
    "automaticDeploymentsMustBeDisabled": true,
    "requiredEvidenceFields": ["source.config.deployments_enabled", "source.config.production_deployments_enabled", "source.config.preview_deployment_setting"],
    "unknownOrUnavailable": "fail-closed"
  }
}
