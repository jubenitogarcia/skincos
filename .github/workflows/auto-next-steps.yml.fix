name: Auto Next Steps

on:
  push:
    branches: [ main ]
  workflow_dispatch: {}

jobs:
  suggest:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      issues: write
      pull-requests: write
    env:
      USE_GH_MODELS: "0"
      MODEL_ID: gpt-4o-mini
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Generate next-steps suggestion
        id: gen
        run: |
          echo "Analyzing repository changes to propose next steps..."
          git fetch --depth=2 origin main || true
          LAST_SHA=$(git rev-parse HEAD)
          PREV_SHA=$(git rev-parse HEAD^ || echo "")
          echo "last_sha=$LAST_SHA" >> $GITHUB_OUTPUT
          echo "prev_sha=$PREV_SHA" >> $GITHUB_OUTPUT
          DIFF_FILES=$(git --no-pager diff --name-only "$PREV_SHA" "$LAST_SHA" || true)
          echo "Changed files:\n$DIFF_FILES"
          SUMMARY=$(git --no-pager log -1 --pretty=%B)
          {
            echo "summary<<EOF"
            echo "$SUMMARY"
            echo "EOF"
          } >> $GITHUB_OUTPUT
          PLAN=""
          echo "$DIFF_FILES" | grep -q "comprehensive-crm-so/" && PLAN+=$'• Frontend/API CRM changed: run UI smoke, check orchestrator endpoints (instances, force-clean, start), validate unread/search flows.\n' || true
          echo "$DIFF_FILES" | grep -q "whatsapp-gateway/" && PLAN+=$'• Gateway changed: run e2e-multi-instance smoke, validate /v1/search and /v1/chats/unread-counts.\n' || true
          echo "$DIFF_FILES" | grep -q "broadhub/\|a0/" && PLAN+=$'• Other modules touched: run their local scripts if present and basic health checks.\n' || true
          [ -z "$PLAN" ] && PLAN=$'• No module-specific changes detected; consider adding tests or docs.\n'
          {
            echo "plan<<EOF"
            echo "$PLAN"
            echo "EOF"
          } >> $GITHUB_OUTPUT

      - name: Open issue with next steps (heuristic)
        uses: actions/github-script@v7
        with:
          script: |
            const summary = core.getInput('summary', { required: false }) || '';
            const plan = core.getInput('plan', { required: false }) || '';
            const body = `Automated next-steps suggestion\n\nRecent commit summary:\n\n${summary}\n\nProposed next steps (heuristic):\n\n${plan}\n\nNote: This workflow uses free heuristics only. To enable GitHub Models free tiers, create a separate workflow.`;
            const title = `Auto next-steps • ${new Date().toISOString()}`;
            try {
              const res = await github.rest.issues.create({ owner: context.repo.owner, repo: context.repo.repo, title, body });
              core.notice(`Created issue #${res.data.number}`);
            } catch (e) {
              core.warning(`Failed to create issue: ${e.message}`);
            }
