#!/usr/bin/env bash
set -euo pipefail

# One-command launcher for the interactive menu.
# Usage: ./menu

cd "$(dirname "$0")"

if [ -x "./.venv/bin/python" ]; then
  PY="./.venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
  PY="python3"
elif command -v python >/dev/null 2>&1; then
  PY="python"
else
  echo "ERROR: Python not found. Install Python 3 and try again." >&2
  exit 127
fi

exec "$PY" "run_scraper.py" "$@"
