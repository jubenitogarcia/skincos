import { fetch } from 'wix-fetch';

/**
 * Envia inscrição para GitHub via commit direto
 * Esta função cria um arquivo CSV no repositório GitHub, disparando automaticamente o workflow
 *
 * @param {Object} dadosParticipante - Dados do formulário
 * @returns {Promise<Object>} Resultado com status e informações
 */
export async function enviarInscricaoParaGitHub(dadosParticipante) {

  // ========================================
  // CONFIGURAÇÃO - PREENCHA COM SEUS DADOS
  // ========================================

  const GITHUB_TOKEN = 'SEU_GITHUB_TOKEN_AQUI';  // Token com permissão repo
  const GITHUB_OWNER = 'jubenitogarcia';
  const GITHUB_REPO = 'Sprinta-Scraper';
  const BRANCH = 'main';

  try {
    // 1️⃣ Gerar CSV
    const timestamp = new Date().toISOString().replace(/[:.]/g, '-');
    const filename = `inscricao_${timestamp}.csv`;

    const csvContent = `name;email;phone;cpf;bday;gender;shirt_size;team
${dadosParticipante.name};${dadosParticipante.email};${dadosParticipante.phone};${dadosParticipante.cpf};${dadosParticipante.bday};${dadosParticipante.gender};${dadosParticipante.shirtSize};${dadosParticipante.team || 'Espaço Facial'}`;

    // 2️⃣ Converter para Base64
    const base64Content = Buffer.from(csvContent).toString('base64');

    console.log('📤 Enviando CSV para GitHub:', filename);

    // 3️⃣ Criar arquivo via GitHub API
    const response = await fetch(
      `https://api.github.com/repos/${GITHUB_OWNER}/${GITHUB_REPO}/contents/inscricoes/${filename}`,
      {
        method: 'PUT',
        headers: {
          'Authorization': `Bearer ${GITHUB_TOKEN}`,
          'Accept': 'application/vnd.github+json',
          'X-GitHub-Api-Version': '2022-11-28',
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          message: `feat: nova inscrição - ${dadosParticipante.email}`,
          content: base64Content,
          branch: BRANCH
        })
      }
    );

    if (!response.ok) {
      const errorData = await response.text();
      throw new Error(`GitHub API error (${response.status}): ${errorData}`);
    }

    const result = await response.json();

    console.log('✅ CSV commitado com sucesso!');
    console.log('📄 Arquivo:', result.content.name);
    console.log('🔗 Commit:', result.commit.sha);

    // 4️⃣ Aguardar processamento (polling)
    console.log('⏳ Aguardando processamento (pode levar ~10-15 segundos)...');

    const checkoutUrl = await aguardarResultado(
      GITHUB_TOKEN,
      GITHUB_OWNER,
      GITHUB_REPO,
      filename,
      dadosParticipante.email
    );

    return {
      success: true,
      filename: filename,
      commitSha: result.commit.sha,
      commitUrl: result.commit.html_url,
      checkoutUrl: checkoutUrl,
      message: 'Inscrição processada com sucesso!'
    };

  } catch (error) {
    console.error('❌ Erro ao enviar para GitHub:', error);

    return {
      success: false,
      error: error.message,
      message: 'Erro ao processar inscrição. Tente novamente.'
    };
  }
}

/**
 * Aguarda o resultado do processamento checando a pasta resultados/
 * Faz polling a cada 3 segundos por até 30 segundos
 */
async function aguardarResultado(token, owner, repo, csvFilename, email) {
  const maxAttempts = 10;  // 10 tentativas x 3s = 30s
  const delayMs = 3000;    // 3 segundos entre tentativas

  const basename = csvFilename.replace('.csv', '');

  for (let attempt = 1; attempt <= maxAttempts; attempt++) {
    console.log(`🔍 Tentativa ${attempt}/${maxAttempts}: Checando resultados...`);

    try {
      // Listar arquivos na pasta resultados/
      const response = await fetch(
        `https://api.github.com/repos/${owner}/${repo}/contents/resultados`,
        {
          headers: {
            'Authorization': `Bearer ${token}`,
            'Accept': 'application/vnd.github+json',
            'X-GitHub-Api-Version': '2022-11-28'
          }
        }
      );

      if (response.ok) {
        const files = await response.json();

        // Procurar arquivo de resultado correspondente
        const resultFile = files.find(file =>
          file.name.startsWith(basename) && file.name.endsWith('.json')
        );

        if (resultFile) {
          console.log('✅ Arquivo de resultado encontrado!');

          // Baixar conteúdo do arquivo
          const contentResponse = await fetch(resultFile.download_url);
          const resultData = await contentResponse.json();

          // Extrair checkout URL
          if (resultData.results && resultData.results.length > 0) {
            const participante = resultData.results.find(r => r.email === email);

            if (participante && participante.checkout_url) {
              console.log('🎉 Checkout URL encontrada!');
              return participante.checkout_url;
            }
          }
        }
      }

    } catch (error) {
      console.warn(`⚠️ Erro ao checar resultado (tentativa ${attempt}):`, error.message);
    }

    // Aguardar antes da próxima tentativa (exceto na última)
    if (attempt < maxAttempts) {
      await new Promise(resolve => setTimeout(resolve, delayMs));
    }
  }

  // Timeout: não encontrou resultado a tempo
  console.warn('⏱️ Timeout: Processamento ainda em andamento');
  throw new Error('Processamento está demorando mais que o esperado. Verifique seu e-mail em breve.');
}
