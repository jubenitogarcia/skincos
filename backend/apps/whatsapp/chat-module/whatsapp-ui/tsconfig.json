{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "jsx": "react-jsx",
        "allowJs": true,
        "isolatedModules": true,
        "moduleResolution": "node",
        "target": "ES2022",
        "module": "ES2022",
        "types": [
            "node",
            "react",
            "react-dom"
        ],
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "src"
    ],
    "exclude": [
        "dist"
    ]
}
