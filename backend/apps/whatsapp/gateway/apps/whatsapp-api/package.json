{
  "name": "@whatsapp-monorepo/whatsapp-api",
  "version": "1.0.0",
  "description": "WhatsApp Enterprise API - Main API service for WhatsApp automation",
  "main": "src/index.js",
  "scripts": {
    "build": "echo 'No build needed for pure JS'",
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "test": "mocha tests/**/*.js --timeout 5000",
    "test:coverage": "c8 mocha tests/**/*.js --timeout 5000",
    "lint": "eslint src tests --ext .js",
    "lint:fix": "eslint src tests --ext .js --fix",
    "format": "prettier --write 'src/**/*.js' 'tests/**/*.js'",
    "typecheck": "echo 'No TypeScript files to check'",
    "clean": "rm -rf node_modules/.cache",
    "coverage": "c8 report --reporter=text --reporter=lcov --reporter=html"
  },
  "dependencies": {
    "@pedroslopez/moduleraid": "^5.0.2",
    "axios": "^1.13.3",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "fluent-ffmpeg": "2.1.3",
    "helmet": "^7.1.0",
    "joi": "^17.12.0",
    "jsonwebtoken": "^9.0.2",
    "mime": "^3.0.0",
    "node-fetch": "^2.6.9",
    "node-webpmux": "3.1.7",
    "prom-client": "^15.1.2",
    "puppeteer": "^24.16.0",
    "qrcode-terminal": "^0.12.0",
    "redis": "^4.6.14",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node-fetch": "^2.5.12",
    "chai": "^4.3.4",
    "chai-as-promised": "^7.1.1",
    "dotenv": "^16.0.0",
    "eslint": "^8.4.1",
    "eslint-plugin-mocha": "^10.0.3",
    "mocha": "^11.7.1",
    "nodemon": "^3.0.0",
    "prettier": "^3.1.0",
    "sinon": "^13.0.1",
    "c8": "^10.1.2"
  },
  "optionalDependencies": {
    "archiver": "^5.3.1",
    "fs-extra": "^10.1.0",
    "unzipper": "^0.10.11"
  },
  "c8": {
    "reporter": [
      "text",
      "lcov",
      "html"
    ],
    "reports-dir": "coverage",
    "all": true,
    "include": [
      "src/**/*.js"
    ],
    "exclude": [
      "**/*.test.js",
      "**/*.spec.js",
      "**/tests/**",
      "**/test/**",
      "**/node_modules/**",
      "**/coverage/**"
    ]
  }
}
