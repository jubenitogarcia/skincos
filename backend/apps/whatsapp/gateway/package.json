{
  "name": "@whatsapp-monorepo/root",
  "version": "1.0.0",
  "description": "WhatsApp Enterprise Monorepo - Unified codebase for WhatsApp integrations",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "start": "turbo run start",
    "setup": "pnpm install && turbo run build",
    "release": "turbo run build test lint && changeset publish",
    "deploy": "./tools/scripts/deploy.sh",
    "deploy:local": "./tools/scripts/deploy.sh local",
    "deploy:dev": "./tools/scripts/deploy.sh local --env dev",
    "deploy:prod": "./tools/scripts/deploy.sh local --env prod",
    "deploy:test": "./tools/scripts/deploy.sh local --env test",
    "deploy:railway": "./tools/scripts/deploy.sh railway",
    "deploy:docker": "./tools/scripts/deploy.sh docker",
    "deploy:infrastructure": "./tools/scripts/deploy.sh infrastructure",
    "test:all": "./tools/scripts/test.sh all",
    "test:unit": "./tools/scripts/test.sh unit",
    "test:api": "./tools/scripts/test.sh api",
    "test:connectivity": "./tools/scripts/test.sh connectivity",
    "test:watch": "./tools/scripts/test.sh unit --watch",
    "test:coverage": "c8 pnpm test",
    "coverage": "c8 report --reporter=text --reporter=lcov --reporter=html",
    "coverage:clean": "c8 clean",
    "setup:all": "./tools/scripts/setup.sh all",
    "setup:node": "./tools/scripts/setup.sh node",
    "setup:docker": "./tools/scripts/setup.sh docker",
    "setup:chromium": "./tools/scripts/setup.sh chromium",
    "services:start": "./tools/scripts/manage.sh start",
    "services:stop": "./tools/scripts/manage.sh stop",
    "services:restart": "./tools/scripts/manage.sh restart",
    "services:status": "./tools/scripts/manage.sh status",
    "services:logs": "./tools/scripts/manage.sh logs",
    "services:health": "./tools/scripts/manage.sh health"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jubenitogarcia/WhatsApp.git"
  },
  "keywords": [
    "whatsapp",
    "monorepo",
    "api",
    "bot",
    "enterprise",
    "automation",
    "agent-zero"
  ],
  "author": "jubenitogarcia",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/jubenitogarcia/WhatsApp/issues"
  },
  "homepage": "https://github.com/jubenitogarcia/WhatsApp",
  "dependencies": {
    "@pedroslopez/moduleraid": "^5.0.2",
    "axios": "^1.12.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "fluent-ffmpeg": "2.1.3",
    "helmet": "^7.1.0",
    "joi": "^17.12.0",
    "jsonwebtoken": "^9.0.2",
    "mime": "^3.0.0",
    "node-fetch": "^2.6.9",
    "node-webpmux": "3.1.7",
    "prom-client": "^15.1.2",
    "puppeteer": "^24.16.0",
    "qrcode-terminal": "^0.12.0",
    "redis": "^4.6.14",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.1",
    "@types/node": "^20.0.0",
    "c8": "^10.1.2",
    "eslint": "^8.4.1",
    "nodemon": "^3.1.10",
    "prettier": "^3.1.0",
    "turbo": "^1.11.2",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "optionalDependencies": {
    "archiver": "^5.3.1",
    "fs-extra": "^10.1.0",
    "unzipper": "^0.10.11"
  },
  "c8": {
    "reporter": [
      "text",
      "lcov",
      "html"
    ],
    "reports-dir": "coverage",
    "all": true,
    "include": [
      "src/**/*.js",
      "apps/*/src/**/*.js",
      "packages/*/src/**/*.js"
    ],
    "exclude": [
      "**/*.test.js",
      "**/*.spec.js",
      "**/tests/**",
      "**/test/**",
      "**/node_modules/**",
      "**/coverage/**",
      "**/.nyc_output/**",
      "**/.git/**",
      "**/dist/**",
      "**/build/**"
    ]
  }
}
