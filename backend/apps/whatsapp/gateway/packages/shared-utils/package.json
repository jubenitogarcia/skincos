{
  "name": "@whatsapp-monorepo/shared-utils",
  "version": "1.0.0",
  "description": "Shared utilities for WhatsApp monorepo",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "scripts": {
    "build": "echo 'No build needed for pure JS'",
    "test": "mocha src/**/*.test.js",
