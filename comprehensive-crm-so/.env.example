# =============================================================================
# CRM SYSTEM ENVIRONMENT VARIABLES
# Copy this file to .env and configure the values for your environment
# =============================================================================

# --------------------- REPLIT AUTH CONFIGURATION ---------------------
# Required for Replit Auth integration - server will continue without auth if not set

# Your Replit application ID (from Replit Auth settings)
# REPL_ID=your-repl-id-here

# Comma-separated list of domains where your app runs (for OAuth callbacks)
# Example: domain1.replit.app,domain2.replit.dev
# REPLIT_DOMAINS=your-domain.replit.app

# Secret key for session encryption (generate a strong random string)
# If not set, a development fallback will be used (NOT FOR PRODUCTION!)
# SESSION_SECRET=your-super-secure-session-secret-here

# OpenID Connect issuer URL (optional, defaults to https://replit.com/oidc)
# ISSUER_URL=https://replit.com/oidc

# --------------------- DATABASE CONFIGURATION ---------------------
# PostgreSQL database connection (automatically provided in Replit)
# DATABASE_URL=postgresql://user:password@host:port/database

# --------------------- APPLICATION SETTINGS ---------------------
# Node.js environment (affects cookie security, logging, etc.)
NODE_ENV=development

# CRM server ports (must use Replit-allowed ports)
CRM_PORT=5000        # Frontend server (Vite dev server)
CRM_API_PORT=8099    # Backend API server

# Basic auth for API access (optional) - format: username:password
# CRM_BASIC_AUTH=admin:password

# --------------------- FILE STORAGE PATHS ---------------------
# Custom paths for data persistence (optional - defaults to current directory)
# CRM_CONVERSATIONS_FILE=./conversations_store.json
# CRM_MESSAGES_FILE=./messages_store.json
# CRM_SUPPRESSION_FILE=./ai_suppression.json
# CRM_WA_INSTANCES_META=./wa_instances_meta.json
# CRM_EMAIL_TEMPLATES_FILE=./email_templates.json

# --------------------- EXTERNAL INTEGRATIONS ---------------------
# Agent Zero integration URLs (optional)
# AGENT_ZERO_SUPPRESSION_URL=http://localhost:6800/api/suppress
# AGENT_ZERO_COMPLETIONS_URL=http://localhost:6800/api/completions
# AGENT_ZERO_SUGGEST_URL=http://localhost:6800/api/suggestions

# --------------------- FRONTEND CONFIGURATION ---------------------
# Meta/Facebook integration for frontend (optional)
# VITE_META_APP_ID=your-meta-app-id
# VITE_META_APP_SECRET=your-meta-app-secret

# NO_AUTH MODE: Disable authentication completely (development only)
# Set to 'true' to bypass all authentication checks
# WARNING: Never use in production! Automatically disabled if NODE_ENV=production
# VITE_NO_AUTH=true

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
# 
# 1. REPLIT AUTH SETUP (Optional - system works without it):
#    - Go to your Repl settings > Security tab
#    - Enable "Replit Auth"
#    - Copy your REPL_ID from the auth settings
#    - Set REPLIT_DOMAINS to your repl's domain
#    - Generate a strong SESSION_SECRET
#
# 2. DATABASE SETUP:
#    - Database tables (users, sessions) are created automatically
#    - DATABASE_URL is provided automatically in Replit environment
#
# 3. BASIC TESTING:
#    - Set NODE_ENV=development for local testing
#    - All other variables are optional for basic functionality
#
# 4. PRODUCTION SETUP:
#    - Set NODE_ENV=production
#    - Use strong SESSION_SECRET
#    - Configure all relevant external service URLs
#
# =============================================================================