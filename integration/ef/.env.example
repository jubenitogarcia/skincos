# Copie para .env e ajuste conforme necessário (não commitar .env)

# Login (opcional; se não tiver, o menu pergunta)
# EF_LOGIN_EMAIL=
# EF_LOGIN_PASSWORD=

# Unidade
# EF_UNIT_NAME=
# EF_UNIT_OPTIONS=BarraShoppingSul,Novo Hamburgo

# Pastas (defaults já ok)
# EF_OUTPUT_DIR=./report
# EF_DEBUG_DIR=./debug
# EF_LOG_DIR=./debug

# Chrome
# HEADLESS=0
# EF_PERSIST_SESSION=1
# EF_CHROME_USER_DATA_DIR=./chrome_profile
# Permite autenticação manual na janela do scraper quando não há credenciais locais
# EF_WAIT_FOR_MANUAL_LOGIN=1
# EF_MANUAL_LOGIN_TIMEOUT_SECONDS=300

# Base URL (normalmente não precisa mexer)
# EF_BASE_URL=https://app.espacofacial.com.br

# Agenda sync (the canonical production host is always permitted; add approved
# staging hostnames only, comma-separated, without scheme, path or port)
# EF_AGENDA_SYNC_URL=https://espacofacial.com/api/agenda/sync
# EF_AGENDA_SYNC_ALLOWED_HOSTS=agenda-staging.skincos.com.br
# EF_AGENDA_SYNC_TOKEN=

# Execução direta (sem menu)
# EF_MODE=agenda|caixa|procedures|client_registration|recorder|selftest|booking_api

# Smoke do cadastro de clientes (vazio = percorre todas as páginas/clientes)
# EF_CLIENT_REGISTRATION_MAX_PAGES=1
# EF_CLIENT_REGISTRATION_MAX_CLIENTS_PER_UNIT=2

# Booking API local
# EF_BOOKING_API_HOST=127.0.0.1
# EF_BOOKING_API_PORT=8765
# EF_BOOKING_API_TOKEN=
# EF_BOOKING_WEBHOOK_SECRET=
# EF_BOOKING_ENV_FILE=./secrets/booking_api.env

# Dry-run (não salva arquivos)
# EF_DRY_RUN=1

# Limpeza automática de debug (dias)
# EF_DEBUG_RETENTION_DAYS=7

# Data range automático
# EF_DATE_RANGE_MODE=prev_month

# Recorder: apagar gravações após processar
# EF_RECORDER_PURGE=1
