# Local-only vars for `wrangler dev` (copy to `.dev.vars` and fill values)
# IMPORTANT: `.dev.vars` is ignored by git.
#
# D1-only: this Worker requires a D1 binding named `DB` (configured in `wrangler.toml` and/or Cloudflare dashboard).

# Local dev helpers
# APP_ORIGIN="http://localhost:5173"
# APP_ORIGINS="http://localhost:5173,https://crm.skincos.com.br,https://app.skincos.com.br"
# SESSION_COOKIE_DOMAIN=".skincos.com.br"
# SESSION_SECRET="dev-only-secret"
# ALLOW_DEV_SEED=true
# INSUMOS_SEED_TOKEN="dev-seed-token"

# Password recovery (use a private local .dev.vars only; never commit credentials)
# AUTH_RESET_SMTP_HOST="smtp.mail.me.com"
# AUTH_RESET_SMTP_PORT="587"
# AUTH_RESET_SMTP_USERNAME="your-primary-icloud-address@icloud.com"
# AUTH_RESET_SMTP_PASSWORD=""
# AUTH_RESET_EMAIL_FROM="contato@skincos.com.br"
# AUTH_RESET_CODE_PEPPER="generate-a-random-private-value"

# Units (scales beyond 2 units)
# UNIDADES="novo-hamburgo,barra-shopping-sul"
# If your sheet uses non-standard headers for unit stock columns, map unit slug -> header key (lowercase).
# UNIDADES_HEADERS_JSON="{\"barra-shopping-sul\":\"barrashoppingsul\",\"novo-hamburgo\":\"novo hamburgo\"}"
