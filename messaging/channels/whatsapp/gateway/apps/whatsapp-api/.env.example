# Server Configuration
PORT=3001
NODE_ENV=development

# WhatsApp Configuration  
WHATSAPP_SESSION_NAME=whatsapp-session
WHATSAPP_WEBHOOK_SECRET=your-webhook-secret-here

# Agent Zero Integration
AGZ_WEBHOOK_URL=http://localhost:50001/webhook
AGZ_INTERNAL_BASE=http://localhost:50001
AGZ_INTERNAL_ENABLE_DIRECT=1
AGZ_INTERNAL_BASIC_AUTH=user:password

# Database (if using)
# DATABASE_URL=postgresql://user:password@localhost:5432/whatsapp
# REDIS_URL=redis://localhost:6379

# Security
AUTH_LOGIN=admin
AUTH_PASSWORD=your-admin-password
JWT_SECRET=your-jwt-secret-here

# File Upload
MAX_FILE_SIZE=100MB
ALLOWED_FILE_TYPES=image,video,audio,document

# Puppeteer Configuration
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage