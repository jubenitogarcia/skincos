[Unit]
Description=Skincos n8n shared runtime
After=network-online.target postgresql.service postgresql@16-main.service
Wants=network-online.target postgresql.service postgresql@16-main.service

[Service]
Type=simple
User=skincos
Group=skincos
WorkingDirectory=__N8N_ROOT__
Environment=N8N_ROOT=__N8N_ROOT__
Environment=N8N_RUNTIME_HOME=__N8N_RUNTIME_HOME__
Environment=N8N_ENV_FILE=__N8N_ENV_FILE__
Environment=N8N_BUSINESS_ENV_FILE=__N8N_BUSINESS_ENV_FILE__
Environment=N8N_DATA_HOME=__N8N_DATA_HOME__
Environment=N8N_USER_FOLDER=__N8N_DATA_HOME__
Environment=N8N_LOG_DIR=__N8N_LOG_DIR__
Environment=N8N_HEALTH_DIR=__N8N_HEALTH_DIR__
Environment=N8N_TMP_DIR=__N8N_TMP_DIR__
Environment=N8N_BINARY_DATA_DIR=__N8N_BINARY_DATA_DIR__
Environment=N8N_STORAGE_PATH=__N8N_STORAGE_PATH__
EnvironmentFile=-__N8N_ENV_FILE__
EnvironmentFile=-__N8N_BUSINESS_ENV_FILE__
ExecStartPre=__N8N_ROOT__/scripts/wait-for-local-postgres.sh
ExecStart=/usr/local/bin/n8n start
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__N8N_RUNTIME_HOME__
UMask=0027
StandardOutput=append:__N8N_LOG_DIR__/system-skincos-n8n.out.log
StandardError=append:__N8N_LOG_DIR__/system-skincos-n8n.err.log

[Install]
WantedBy=multi-user.target
