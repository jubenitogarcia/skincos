# Dockerfile alternativo usando imagem com Chrome pré-instalado
FROM ghcr.io/puppeteer/puppeteer:21.3.8

# Mudar para usuário root para instalar dependências
USER root

# Instalar FFmpeg e outras dependências
RUN apt-get update && apt-get install -y \
    ffmpeg \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Definir diretório de trabalho
WORKDIR /app

# Criar diretório para vídeos temporários
RUN mkdir -p temp_videos

# Mudar dono do diretório para o usuário pptruser
RUN chown -R pptruser:pptruser /app

# Voltar para usuário pptruser
USER pptruser

# Copiar package.json e instalar dependências
COPY --chown=pptruser:pptruser package*.json ./
RUN npm install

# Copiar resto dos arquivos
COPY --chown=pptruser:pptruser . .

# Expor porta
EXPOSE 3001

# Comando de inicialização
CMD ["node", "bot_com_api.js"]
