# Dockerfile com abordagem simples para Puppeteer
FROM node:18-slim

# Instalar dependências básicas
RUN apt-get update && apt-get install -y \
    wget \
    curl \
    gnupg \
    ca-certificates \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libdrm2 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libgbm1 \
    libxss1 \
    libgconf-2-4 \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Definir diretório de trabalho
WORKDIR /app

# Criar diretório para vídeos temporários
RUN mkdir -p temp_videos

# Definir variáveis de ambiente para Puppeteer
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=false
ENV PUPPETEER_CACHE_DIR=/app/.cache/puppeteer

# Copiar package.json primeiro para cache
COPY package*.json ./

# Instalar dependências
RUN npm install

# Verificar e baixar Chromium se necessário
RUN npm list puppeteer && \
    node -e "const puppeteer = require('puppeteer'); console.log('Puppeteer está funcionando!');" || \
    npm install puppeteer@18.2.1 --force

# Copiar resto dos arquivos
COPY . .

# Expor porta
EXPOSE 3001

# Comando de inicialização
CMD ["node", "bot_com_api.js"]
