# n8n WhatsApp (Evolution) -> Postgres -> Google Calendar

# Evolution API
EVOLUTION_BASE_URL=https://wa.skincos.com.br
EVOLUTION_INSTANCE_NAME=skincos
EVOLUTION_API_KEY=change-me

# n8n base URL (para webhooks públicos)
N8N_PUBLIC_BASE_URL=https://orb.skincos.com.br

# Banco
DATABASE_URL=postgres://user:pass@localhost:5432/skincos

# Unidade padrão
N8N_DEFAULT_UNIT_SLUG=novo_hamburgo
N8N_DEFAULT_UNIT_NAME=SkinCos Novo Hamburgo
N8N_UNIT_NAME_MAP={"novo_hamburgo":"SkinCos Novo Hamburgo","barra_shopping":"SkinCos Barra Shopping"}

# Notificação de handoff humano (WhatsApp interno)
N8N_HANDOFF_NOTIFY_NUMBER=5511999999999

# Calendário
GOOGLE_CALENDAR_ID=primary
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
GOOGLE_REDIRECT_URI=https://orb.skincos.com.br/rest/oauth2-credential/callback
# GOOGLE_CALENDAR_ID_* (a definir)

# Testes locais (fallback para envio)
N8N_DEFAULT_TEST_PHONE=5511999999999

# Meta Ads - Performance Report
META_ADS_ACCOUNT_ID=change-me
META_ADS_API_VERSION=v24.0
META_ADS_ACCESS_TOKEN=change-me
META_ADS_REPORT_MODE=full
META_ADS_REPORT_ENVIRONMENT=production
META_ADS_REPORT_STORAGE_MODE=cloudflare_worker
META_ADS_REPORT_WORKER_BASE_URL=https://skincos-meta-ads-performance-report.skincos.workers.dev
META_ADS_REPORT_WORKER_PERSIST_PATH=/ingest/meta-ads-performance-report
META_ADS_REPORT_WORKER_AUTH_HEADER=Authorization
META_ADS_REPORT_WORKER_AUTH_SCHEME=Bearer
META_ADS_REPORT_WORKER_API_TOKEN=change-me
META_ADS_REPORT_WORKER_TIMEOUT_MS=120000
META_ADS_REPORT_D1_DATABASE_NAME=skincos-meta-ads-performance-report
META_ADS_REPORT_R2_BUCKET_NAME=skincos-meta-ads-performance-report-raw
META_ADS_REPORT_RAW_PAYLOADS_ENABLED=true
META_ADS_REPORT_COMPAT_EXPORT_ENABLED=false
META_ADS_REPORT_COMPAT_EXPORT_TARGET=google_sheets_optional
