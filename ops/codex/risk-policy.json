{
  "schemaVersion": 2,
  "defaultRisk": "medium",
  "levels": {
    "low": {
      "label": "low",
      "requiredChecks": ["diff-check", "static-parse"],
      "skippedChecks": ["module-test", "focused-test", "module-build", "integration", "staging-smoke", "deep-security-scan"]
    },
    "medium": {
      "label": "normal",
      "requiredChecks": ["diff-check", "one-focused-test-or-build"],
      "skippedChecks": ["unrelated-module-test", "full-suite", "staging-smoke", "deep-security-scan"]
    },
    "high": {
      "label": "elevated",
      "requiredChecks": ["diff-check", "focused-test-or-focal-journey", "rollback-plan"],
      "skippedChecks": ["unrelated-domain-test", "full-suite", "staging-smoke", "deep-security-scan"]
    },
    "critical": {
      "label": "exceptional",
      "requiredChecks": ["diff-check", "focal-validation", "rollback-plan", "exceptional-stop"],
      "skippedChecks": []
    }
  },
  "surfaces": [
    {
      "id": "documentation",
      "patterns": ["AGENTS.md", "CODEX_CONTEXT.md", "TASKS.md", "DECISIONS.md", "docs/**", "**/*.md"],
      "releaseInput": false
    },
    {
      "id": "codex-baseline",
      "patterns": [".codex/**", "skills/**", "scripts/codex-*.mjs", "scripts/tests/codex-*.mjs", "scripts/tests/fixtures/codex-*", "scripts/codex-*.sh", "scripts/*codex*.ps1", "ops/codex/**", "ops/governance/**"],
      "releaseInput": true
    },
    {
      "id": "shared-contracts",
      "patterns": ["shared/**", "**/*contract*"],
      "releaseInput": true
    },
    {
      "id": "global-coordination",
      "patterns": ["ops/governance/**", "ops/cloudflare/global-coordinator/**", "scripts/codex-global-coordination*.mjs", "scripts/tests/codex-global-coordination*.mjs"],
      "releaseInput": true
    },
    {
      "id": "github-governance",
      "patterns": [".github/governance/**", ".github/workflows/**", ".github/scripts/**"],
      "releaseInput": true
    },
    {
      "id": "timekeeping",
      "patterns": ["workforce/timekeeping/**", "crm/console/**", "crm/api/**", "api/**"],
      "releaseInput": true
    },
    {
      "id": "website",
      "patterns": ["website/**", "booking/**"],
      "releaseInput": true
    },
    {
      "id": "runtime",
      "patterns": ["platform/**", "ops/runtime/**", "orb/**", "messaging/**", "service/**"],
      "releaseInput": true
    }
  ],
  "languageRules": [
    { "id": "typescript", "patterns": ["**/*.ts", "**/*.tsx"] },
    { "id": "javascript", "patterns": ["**/*.js", "**/*.cjs", "**/*.mjs", "**/*.jsx"] },
    { "id": "python", "patterns": ["**/*.py"] },
    { "id": "shell", "patterns": ["**/*.sh", "**/*.bash"] },
    { "id": "json", "patterns": ["**/*.json", "**/*.jsonc"] },
    { "id": "yaml", "patterns": ["**/*.yml", "**/*.yaml"] },
    { "id": "toml", "patterns": ["**/*.toml"] },
    { "id": "sql", "patterns": ["**/*.sql"] },
    { "id": "css", "patterns": ["**/*.css", "**/*.scss"] },
    { "id": "html", "patterns": ["**/*.html", "**/*.htm"] },
    { "id": "markdown", "patterns": ["**/*.md", "**/*.mdx"] },
    { "id": "graphql", "patterns": ["**/*.graphql", "**/*.gql"] },
    { "id": "go", "patterns": ["**/*.go"] },
    { "id": "rust", "patterns": ["**/*.rs"] },
    { "id": "java", "patterns": ["**/*.java"] },
    { "id": "kotlin", "patterns": ["**/*.kt", "**/*.kts"] },
    { "id": "swift", "patterns": ["**/*.swift"] }
  ],
  "dependencyPatterns": [
    "**/package.json",
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/yarn.lock",
    "**/requirements*.txt",
    "**/pyproject.toml",
    "**/poetry.lock",
    "**/Cargo.toml",
    "**/Cargo.lock",
    "**/go.mod",
    "**/go.sum"
  ],
  "sharedContractPatterns": [
    "shared/**",
    "**/*contract*",
    "ops/codex/**",
    "ops/governance/**",
    ".github/governance/**",
    "scripts/codex-autonomy-lib.mjs",
    "scripts/codex-risk-classifier.mjs"
  ],
  "productionSensitivePatterns": [
    ".github/workflows/**",
    ".github/actions/**",
    "api/**",
    "crm/api/**",
    "inventory/src/routes/**",
    "workforce/**",
    "website/**",
    "booking/**",
    "platform/**",
    "ops/runtime/**",
    "orb/**",
    "messaging/**",
    "service/**",
    "ads/meta/**",
    "social/**",
    "**/migrations/**",
    "**/wrangler*.toml",
    "**/worker*.{js,mjs,ts}",
    "**/*tracking*",
    "**/*integration*",
    "**/*webhook*",
    "**/*production-delete*",
    "**/*real-data*",
    "**/*financial-ledger*"
  ],
  "securitySensitivePatterns": [
    "**/auth/**",
    "**/*auth*",
    "**/*session*",
    "**/*permission*",
    "**/*secret*",
    "**/*credential*",
    "**/*token*",
    "**/*password*",
    "**/*security*",
    "**/*csrf*",
    "**/*crypto*",
    "**/*private*key*",
    ".github/workflows/**",
    ".github/scripts/**",
    "ops/governance/**",
    "platform/security/**",
    "inventory/src/routes/**",
    "**/migrations/**",
    "**/*credential-exposure*",
    "**/*real-data*",
    "**/*destructive*",
    "**/*production-delete*"
  ],
  "classificationRules": [
    {
      "risk": "critical",
      "reason": "An explicitly exceptional irreversible, destructive, real-data, financial-ledger, or credential-exposure path changed.",
      "patterns": ["**/*irreversible*", "**/*destructive*", "**/*real-data*", "**/*production-delete*", "**/*financial-ledger*", "**/*credential-exposure*"]
    },
    {
      "risk": "high",
      "reason": "Authentication, sessions, permissions, secrets, migrations, payment, deployment, workflow, Worker, database, tracking, externally integrated, or Inventory route surface changed and needs a focal check plus rollback.",
      "patterns": ["**/auth/**", "**/*auth*", "**/*session*", "**/*permission*", "**/*secret*", "**/*credential*", "**/*token*", "**/*payment*", "**/*billing*", "**/*root*key*", "**/migrations/**", "**/*migration*", ".github/workflows/**", ".github/scripts/**", "workforce/**", "api/**", "crm/api/**", "inventory/src/routes/**", "platform/**", "ops/runtime/**", "website/**/api/**", "ops/cloudflare/**", "ops/governance/**", "scripts/codex-global-coordination*.mjs", "scripts/tests/codex-global-coordination*.mjs", "**/wrangler*.toml", "**/worker*.{js,mjs,ts}", "**/d1/**", "**/*tracking*", "**/*integration*", "**/*webhook*"]
    },
    {
      "risk": "medium",
      "reason": "Codex or governance implementation changed without an elevated executable or exceptional path.",
      "patterns": [".codex/**", "skills/**", "scripts/codex-*.mjs", "scripts/tests/codex-*.mjs", "scripts/codex-*.sh", "scripts/*codex*.ps1", "ops/codex/**", "ops/governance/**", ".github/governance/**"]
    },
    {
      "risk": "low",
      "reason": "A presentation-only asset or explicitly local UI component path changed without an elevated security, dependency, contract, or production marker.",
      "patterns": ["**/*.css", "**/*.scss", "**/*.html", "crm/console/**/*.component.ts", "crm/console/**/*.component.tsx", "crm/console/**/*.component.jsx", "crm/console/**/*.story.tsx", "crm/console/**/*.stories.tsx", "crm/console/**/*.story.jsx", "crm/console/**/*.stories.jsx", "crm/console/**/components/**/*.tsx", "crm/console/**/components/**/*.jsx", "crm/console/**/ui/**/*.tsx", "crm/console/**/ui/**/*.jsx", "crm/console/**/layout/**/*.tsx", "crm/console/**/layout/**/*.jsx"]
    },
    {
      "risk": "low",
      "reason": "Documentation, issue/ledger, or static project guidance changed without an executable surface.",
      "patterns": ["**/*.md", "docs/**", "TASKS.md", "DECISIONS.md", "CODEX_CONTEXT.md", "ops/project-orchestration/**", "docs/project-state/**"]
    }
  ],
  "releaseSharedInputs": ["package.json", "package-lock.json", "pnpm-lock.yaml", "yarn.lock", ".github/governance/progressive-release-policy.json", "ops/codex/risk-policy.json", "ops/governance/global-concurrency-policy.json"]
}
