{
  "schemaVersion": 1,
  "defaultRisk": "medium",
  "levels": {
    "low": {
      "label": "low",
      "requiredChecks": ["diff-check", "static-parse"],
      "skippedChecks": ["module-test", "focused-test", "module-build", "integration", "staging-smoke", "deep-security-scan"]
    },
    "medium": {
      "label": "normal",
      "requiredChecks": ["diff-check", "one-focused-test-or-build"],
      "skippedChecks": ["unrelated-module-test", "full-suite", "staging-smoke", "deep-security-scan"]
    },
    "high": {
      "label": "elevated",
      "requiredChecks": ["diff-check", "focused-test-or-focal-journey", "rollback-plan"],
      "skippedChecks": ["unrelated-domain-test", "full-suite", "staging-smoke", "deep-security-scan"]
    },
    "critical": {
      "label": "exceptional",
      "requiredChecks": ["diff-check", "focal-validation", "rollback-plan", "exceptional-stop"],
      "skippedChecks": []
    }
  },
  "surfaces": [
    {
      "id": "documentation",
      "patterns": ["AGENTS.md", "CODEX_CONTEXT.md", "TASKS.md", "DECISIONS.md", "docs/**", "**/*.md"],
      "releaseInput": false
    },
    {
      "id": "codex-baseline",
      "patterns": [".codex/**", "skills/**", "scripts/codex-*.mjs", "scripts/codex-*.sh", "scripts/*codex*.ps1", "ops/codex/**"],
      "releaseInput": true
    },
    {
      "id": "github-governance",
      "patterns": [".github/governance/**", ".github/workflows/**", ".github/scripts/**"],
      "releaseInput": true
    },
    {
      "id": "timekeeping",
      "patterns": ["workforce/timekeeping/**", "crm/console/**", "crm/api/**", "api/**"],
      "releaseInput": true
    },
    {
      "id": "website",
      "patterns": ["website/**", "booking/**"],
      "releaseInput": true
    },
    {
      "id": "runtime",
      "patterns": ["platform/**", "ops/runtime/**", "orb/**", "messaging/**", "service/**"],
      "releaseInput": true
    }
  ],
  "classificationRules": [
    {
      "risk": "critical",
      "reason": "An explicitly exceptional irreversible, destructive, real-data, financial-ledger, or credential-exposure path changed.",
      "patterns": ["**/*irreversible*", "**/*destructive*", "**/*real-data*", "**/*production-delete*", "**/*financial-ledger*", "**/*credential-exposure*"]
    },
    {
      "risk": "high",
      "reason": "Authentication, sessions, permissions, secrets, migrations, payment, deployment, workflow, Worker, database, tracking, or externally integrated surface changed and needs a focal check plus rollback.",
      "patterns": ["**/auth/**", "**/*auth*", "**/*session*", "**/*permission*", "**/*secret*", "**/*credential*", "**/*payment*", "**/*billing*", "**/*root*key*", "**/migrations/**", "**/*migration*", ".github/workflows/**", ".github/scripts/**", "workforce/**", "api/**", "crm/api/**", "platform/**", "ops/runtime/**", "website/**/api/**", "**/wrangler*.toml", "**/worker*.{js,mjs,ts}", "**/d1/**"]
    },
    {
      "risk": "medium",
      "reason": "Codex or governance implementation changed without an elevated executable or exceptional path.",
      "patterns": [".codex/**", "skills/**", "scripts/codex-*.mjs", "scripts/codex-*.sh", "scripts/*codex*.ps1", "ops/codex/**", ".github/governance/**"]
    },
    {
      "risk": "low",
      "reason": "Documentation, issue/ledger, or static project guidance changed without an executable surface.",
      "patterns": ["**/*.md", "docs/**", "TASKS.md", "DECISIONS.md", "CODEX_CONTEXT.md", "ops/project-orchestration/**", "docs/project-state/**"]
    }
  ],
  "releaseSharedInputs": ["package.json", "package-lock.json", "pnpm-lock.yaml", "yarn.lock", ".github/governance/progressive-release-policy.json", "ops/codex/risk-policy.json"]
}
