[Unit]
Description=SKINCOS Booking API (scraper bridge)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=skincos
Group=skincos
WorkingDirectory=__REPO_ROOT__/backend/apps/automations/scraper
Environment=BOOKING_API_RUNTIME_HOME=__BOOKING_RUNTIME_HOME__
Environment=SKINCOS_BOOKING_API_ENV_FILE=__BOOKING_RUNTIME_HOME__/env/booking-api.env
Environment=EF_SCRAPER_VENV_DIR=__BOOKING_RUNTIME_HOME__/venv
EnvironmentFile=-__BOOKING_RUNTIME_HOME__/env/booking-api.env
ExecStart=__REPO_ROOT__/scripts/migration/run-booking-api-linux.sh
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__BOOKING_RUNTIME_HOME__
UMask=0027

[Install]
WantedBy=multi-user.target
