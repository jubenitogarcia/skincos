[Unit]
Description=SKINCOS Cloudflared Tunnel (cs)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=skincos
Group=skincos
EnvironmentFile=__CS_CLOUDFLARED_HOME__/cloudflared-cs.env
ExecStart=/bin/bash -lc 'exec /usr/bin/cloudflared tunnel --config "$CLOUDFLARED_CONFIG_PATH" run'
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=__CS_CLOUDFLARED_HOME__
UMask=0027

[Install]
WantedBy=multi-user.target
