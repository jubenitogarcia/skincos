[Unit]
Description=SKINCOS CRM API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=skincos
Group=skincos
WorkingDirectory=__REPO_ROOT__
Environment=CRM_RUNTIME_HOME=__CRM_RUNTIME_HOME__
Environment=SKINCOS_CRM_API_ENV_FILE=__CRM_RUNTIME_HOME__/env/crm-api.env
Environment=VAR_DIR=__CRM_RUNTIME_HOME__/var
Environment=BACKEND_DIR=__REPO_ROOT__/backend
Environment=FRONTEND_DIR=__REPO_ROOT__/modules/crm/web
Environment=CONFIG_DIR=__REPO_ROOT__/backend/config
EnvironmentFile=-__CRM_RUNTIME_HOME__/env/crm-api.env
ExecStart=__REPO_ROOT__/scripts/migration/run-crm-api-linux.sh
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__CRM_RUNTIME_HOME__/var
UMask=0027

[Install]
WantedBy=multi-user.target
