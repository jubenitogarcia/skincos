[Unit]
Description=Skincos Booking integration runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=skincos
Group=skincos
WorkingDirectory=__REPO_ROOT__/integration/ef
Environment=BOOKING_API_RUNTIME_HOME=__STATE_ROOT__/booking
Environment=SKINCOS_BOOKING_API_ENV_FILE=__CONFIG_ROOT__/booking.env
Environment=EF_SCRAPER_VENV_DIR=__STATE_ROOT__/booking/venv
Environment=EF_OUTPUT_DIR=__ARTIFACT_ROOT__/booking/report
Environment=EF_DEBUG_DIR=__ARTIFACT_ROOT__/booking/debug
Environment=EF_LOG_DIR=__LOG_ROOT__/booking
Environment=EF_CHROME_USER_DATA_DIR=__STATE_ROOT__/booking/chrome-profile
EnvironmentFile=-__CONFIG_ROOT__/booking.env
ExecStart=__REPO_ROOT__/scripts/booking/run-api-linux.sh
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__STATE_ROOT__/booking __LOG_ROOT__/booking __ARTIFACT_ROOT__/booking __TMP_ROOT__/booking
UMask=0027

[Install]
WantedBy=multi-user.target
