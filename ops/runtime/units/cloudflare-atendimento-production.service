[Unit]
Description=Skincos dedicated Cloudflare tunnel for isolated Atendimento production
After=network-online.target crm-atendimento-production.service
Wants=network-online.target
Requires=crm-atendimento-production.service

[Service]
Type=simple
User=skincos
Group=skincos
# The generated config and tunnel UUID are immutable release inputs.  This
# unit deliberately has no shell, EnvironmentFile or inherited shared tunnel
# configuration.
ExecStart=/usr/bin/cloudflared --config __CONFIG_ROOT__/cloudflare/atendimento-production/config.yml tunnel --protocol http2 run __TUNNEL_ID__
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=__LOG_ROOT__
UMask=0027
SyslogIdentifier=cloudflare-atendimento-production

[Install]
WantedBy=multi-user.target
