[Unit]
Description=Skincos Cloudflare tunnel for Orb
After=orb-proxy.service network-online.target
Wants=orb-proxy.service network-online.target

[Service]
Type=simple
User=skincos
Group=skincos
Environment=CLOUDFLARED_HOME=__CONFIG_ROOT__/cloudflare/orb
ExecStart=/usr/bin/cloudflared tunnel --protocol http2 --config __CONFIG_ROOT__/cloudflare/orb/config.yml run
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__LOG_ROOT__/cloudflare-orb
UMask=0027
StandardOutput=append:__LOG_ROOT__/cloudflare-orb/tunnel.out.log
StandardError=append:__LOG_ROOT__/cloudflare-orb/tunnel.err.log

[Install]
WantedBy=multi-user.target
