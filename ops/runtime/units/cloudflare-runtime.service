[Unit]
Description=Skincos Cloudflare runtime tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=skincos
Group=skincos
EnvironmentFile=__RUNTIME_ROOT__/config/cloudflare/runtime/tunnel.env
ExecStart=/bin/bash -lc 'exec /usr/bin/cloudflared tunnel --config "$CLOUDFLARED_CONFIG_PATH" run'
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=__RUNTIME_ROOT__/config/cloudflare/runtime
UMask=0027

[Install]
WantedBy=multi-user.target
