[Unit]
Description=Skincos Cloudflare runtime tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=skincos
Group=skincos
EnvironmentFile=__CONFIG_ROOT__/cloudflare/runtime/tunnel.env
ExecStart=/bin/bash -lc 'exec /usr/bin/cloudflared tunnel --config "$CLOUDFLARED_CONFIG_PATH" run'
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__LOG_ROOT__/cloudflare-runtime __TMP_ROOT__/cloudflare-runtime
UMask=0027
StandardOutput=append:__LOG_ROOT__/cloudflare-runtime/tunnel.out.log
StandardError=append:__LOG_ROOT__/cloudflare-runtime/tunnel.err.log

[Install]
WantedBy=multi-user.target
