[Unit]
Description=Skincos Clientes isolated production read-only runtime
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=skincos
Group=skincos
WorkingDirectory=__REPO_ROOT__
EnvironmentFile=-__CONFIG_ROOT__/crm-clientes-production-readonly.env
Environment=CRM_RUNTIME_HOME=__STATE_ROOT__/crm-atendimento-production
Environment=VAR_DIR=__STATE_ROOT__/crm-atendimento-production/var
# Security-critical values are pinned after EnvironmentFile so a secret file
# can never turn this service into the shared CRM or re-enable writes.
UnsetEnvironment=NODE_OPTIONS NODE_PATH NODE_REPL_EXTERNAL_MODULE NODE_V8_COVERAGE NODE_REDIRECT_WARNINGS LD_PRELOAD LD_LIBRARY_PATH BASH_ENV ENV
Environment=CRM_DOMAIN=atendimento
Environment=CRM_API_HOST=127.0.0.1
Environment=CRM_API_PORT=8110
Environment=CRM_ATENDIMENTO_READ_ONLY=true
Environment=CRM_ATENDIMENTO_SURFACE=__ATENDIMENTO_SURFACE__
Environment=CRM_ATENDIMENTO_COMMERCIAL_WRITES_ENABLED=false
Environment=CRM_ATENDIMENTO_COMMERCIAL_SOURCE_DEFERRED=true
Environment=CRM_ATENDIMENTO_SCHEMA_MANAGED=true
Environment=CRM_ATENDIMENTO_EXPECTED_DATABASE=skincos_clientes_production
Environment=CRM_ATENDIMENTO_EXPECTED_DATABASE_USER=skincos_clientes_ro
Environment=CRM_ATENDIMENTO_ACTOR_SIGNATURE_VERSION=2
Environment=ATENDIMENTO_RUNTIME_RELEASE_SHA=__RELEASE_SHA__
Environment=ATENDIMENTO_REPLAY_STATE_FILE=__STATE_ROOT__/crm-atendimento-production/var/replay-protection.json
Environment=CRM_MODULE_CONTROL_FILE=__CONFIG_ROOT__/atendimento-production/module-control.json
Environment=HARMONIA_WORKER_ENABLED=false
Environment=WA_BOOTSTRAP_SYNC_ENABLED=false
Environment=WA_BOOTSTRAP_SYNC_AUTO_ON_CONNECTED=false
Environment=CRM_GRACEFUL_SHUTDOWN=true
ExecStart=/usr/bin/node __REPO_ROOT__/crm/api/server/atendimentoRuntime.js
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__STATE_ROOT__/crm-atendimento-production __LOG_ROOT__/crm-atendimento-production
UMask=0027
LimitNOFILE=8192
SyslogIdentifier=crm-atendimento-production

[Install]
WantedBy=multi-user.target
