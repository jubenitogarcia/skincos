[Unit]
Description=Skincos CRM continuous workers
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=skincos
Group=skincos
WorkingDirectory=__REPO_ROOT__
Environment=CRM_RUNTIME_HOME=__STATE_ROOT__/crm
Environment=SKINCOS_CRM_API_ENV_FILE=__CONFIG_ROOT__/crm.env
Environment=VAR_DIR=__STATE_ROOT__/crm/var
Environment=CRM_CONTINUOUS_WORKER_PORT=8102
EnvironmentFile=-__CONFIG_ROOT__/crm.env
EnvironmentFile=-__CONFIG_ROOT__/crm-whatsapp.env
Environment=HARMONIA_WORKER=1
ExecStart=__REPO_ROOT__/scripts/crm/run-continuous-workers-linux.sh
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__STATE_ROOT__/crm __LOG_ROOT__/crm
UMask=0027

[Install]
WantedBy=multi-user.target
