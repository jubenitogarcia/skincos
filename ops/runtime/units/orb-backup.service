[Unit]
Description=Skincos Orb verified backup
After=postgresql.service postgresql@16-main.service
Wants=postgresql.service postgresql@16-main.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=__REPO_ROOT__/orb/engine
Environment=N8N_ROOT=__REPO_ROOT__/orb/engine
Environment=N8N_RUNTIME_HOME=__STATE_ROOT__/orb
Environment=N8N_ENV_FILE=__CONFIG_ROOT__/orb.env
Environment=N8N_BUSINESS_ENV_FILE=__CONFIG_ROOT__/orb-business.env
Environment=N8N_DATA_HOME=__STATE_ROOT__/orb/n8n-home
Environment=N8N_STATE_HOME=__STATE_ROOT__/orb/n8n-home/.n8n
Environment=N8N_STORAGE_PATH=__STATE_ROOT__/orb/n8n-home/.n8n/storage
Environment=N8N_CONFIG_PATH=__STATE_ROOT__/orb/n8n-home/.n8n/config
Environment=N8N_HEALTH_DIR=__STATE_ROOT__/orb/health
Environment=BACKUP_ROOT=__BACKUP_ROOT__/orb/daily
Environment=BACKUP_STORAGE_COPY_TRANSPORT=tar
Environment=BACKUP_PUBLISH_OWNER=admin
Environment=RUNTIME_SERVICE=orb.service
Environment=RETENTION_COUNT=1
Environment=VERIFY_RESTORE=1
ExecStart=__REPO_ROOT__/orb/engine/scripts/backup-n8n.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StandardOutput=append:__LOG_ROOT__/orb/backup.out.log
StandardError=append:__LOG_ROOT__/orb/backup.err.log
