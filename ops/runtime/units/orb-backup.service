[Unit]
Description=Skincos Orb verified backup
After=postgresql.service postgresql@16-main.service
Wants=postgresql.service postgresql@16-main.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=__REPO_ROOT__/orb/engine
Environment=N8N_ROOT=__REPO_ROOT__/orb/engine
Environment=N8N_RUNTIME_HOME=__RUNTIME_ROOT__/state/orb
Environment=N8N_ENV_FILE=__RUNTIME_ROOT__/secrets/orb.env
Environment=N8N_BUSINESS_ENV_FILE=__RUNTIME_ROOT__/secrets/orb-business.env
Environment=N8N_DATA_HOME=__RUNTIME_ROOT__/state/orb/n8n-home
Environment=N8N_STATE_HOME=__RUNTIME_ROOT__/state/orb/n8n-home/.n8n
Environment=N8N_STORAGE_PATH=__RUNTIME_ROOT__/state/orb/n8n-home/.n8n/storage
Environment=N8N_CONFIG_PATH=__RUNTIME_ROOT__/state/orb/n8n-home/.n8n/config
Environment=N8N_HEALTH_DIR=__RUNTIME_ROOT__/state/orb/health
Environment=BACKUP_ROOT=__RUNTIME_ROOT__/backups/orb/daily
Environment=RUNTIME_SERVICE=orb.service
Environment=RETENTION_COUNT=1
Environment=VERIFY_RESTORE=1
ExecStart=__REPO_ROOT__/orb/engine/scripts/backup-n8n.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StandardOutput=append:__RUNTIME_ROOT__/logs/orb/backup.out.log
StandardError=append:__RUNTIME_ROOT__/logs/orb/backup.err.log
