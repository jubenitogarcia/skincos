[Unit]
Description=Skincos Campaign Creative Creator executor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=skincos
Group=skincos
WorkingDirectory=__REPO_ROOT__/orb/engine
Environment=CCG_EXECUTOR_LISTEN_ADDRESS=127.0.0.1
Environment=CCG_EXECUTOR_PORT=8790
Environment=CCG_EXECUTOR_STATE_ROOT=__STATE_ROOT__/orb/ccg-executor
Environment=CCG_EXECUTOR_ARTIFACT_ROOT=__ARTIFACT_ROOT__/orb/ccg-executor
Environment=CCG_EXECUTOR_LIVE_ENABLED=0
EnvironmentFile=-__CONFIG_ROOT__/orb.env
EnvironmentFile=-__CONFIG_ROOT__/orb-business.env
EnvironmentFile=-__CONFIG_ROOT__/orb-runtime-paths.env
EnvironmentFile=-__CONFIG_ROOT__/orb-ccg-executor.env
ExecStart=/usr/bin/node campaign-creative-executor/server.js
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__STATE_ROOT__/orb/ccg-executor __ARTIFACT_ROOT__/orb/ccg-executor __LOG_ROOT__/orb
UMask=0027
StandardOutput=append:__LOG_ROOT__/orb/ccg-executor.out.log
StandardError=append:__LOG_ROOT__/orb/ccg-executor.err.log

[Install]
WantedBy=multi-user.target
