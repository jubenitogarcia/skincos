[Unit]
Description=Skincos Orb proxy
After=orb.service
Wants=orb.service

[Service]
Type=simple
User=skincos
Group=skincos
WorkingDirectory=__REPO_ROOT__/orb/engine
Environment=ORB_RUNTIME_HOME=__STATE_ROOT__/orb
Environment=N8N_ROOT=__REPO_ROOT__/orb/engine
Environment=N8N_RUNTIME_HOME=__STATE_ROOT__/orb
Environment=N8N_ENV_FILE=__CONFIG_ROOT__/orb.env
Environment=N8N_BUSINESS_ENV_FILE=__CONFIG_ROOT__/orb-business.env
Environment=ORB_LOG_DIR=__LOG_ROOT__/orb
Environment=META_REVIEW_STORE_PATH=__STATE_ROOT__/orb/meta-review-store.json
# The proxy is intentionally source-only; http-proxy is supplied by the
# pinned n8n runtime installation rather than an untracked node_modules tree.
Environment=NODE_PATH=/usr/local/lib/node_modules/n8n/node_modules
EnvironmentFile=-__CONFIG_ROOT__/orb.env
EnvironmentFile=-__CONFIG_ROOT__/orb-business.env
ExecStart=/usr/bin/node orb-proxy/server.js
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__STATE_ROOT__/orb __LOG_ROOT__/orb __TMP_ROOT__/orb
UMask=0027
StandardOutput=append:__LOG_ROOT__/orb/orb-proxy.out.log
StandardError=append:__LOG_ROOT__/orb/orb-proxy.err.log

[Install]
WantedBy=multi-user.target
