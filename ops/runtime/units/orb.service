[Unit]
Description=Skincos Orb runtime
After=network-online.target postgresql.service postgresql@16-main.service
Wants=network-online.target postgresql.service postgresql@16-main.service

[Service]
Type=simple
User=skincos
Group=skincos
WorkingDirectory=__REPO_ROOT__/orb/engine
Environment=ORB_ROOT=__REPO_ROOT__/orb/engine
Environment=ORB_RUNTIME_HOME=__RUNTIME_ROOT__/state/orb
Environment=N8N_USER_FOLDER=__RUNTIME_ROOT__/state/orb/n8n-home
Environment=N8N_LOG_DIR=__RUNTIME_ROOT__/logs/orb
Environment=N8N_DIAGNOSTICS_ENABLED=false
EnvironmentFile=-__RUNTIME_ROOT__/secrets/orb.env
EnvironmentFile=-__RUNTIME_ROOT__/secrets/orb-business.env
ExecStartPre=__REPO_ROOT__/orb/engine/scripts/wait-for-local-postgres.sh
ExecStart=/usr/local/bin/n8n start
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__RUNTIME_ROOT__/state/orb __RUNTIME_ROOT__/logs/orb __RUNTIME_ROOT__/tmp/orb
UMask=0027
StandardOutput=append:__RUNTIME_ROOT__/logs/orb/system-orb.out.log
StandardError=append:__RUNTIME_ROOT__/logs/orb/system-orb.err.log

[Install]
WantedBy=multi-user.target
