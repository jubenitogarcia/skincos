[Unit]
Description=SKINCOS trusted GitHub Actions native custody runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=skincos-actions
Group=skincos-actions
WorkingDirectory=/var/lib/skincos-runtime/github-actions-runner
Environment=HOME=/var/lib/skincos-runtime/github-actions-runner
Environment=RUNNER_ALLOW_RUNASROOT=0
ExecStart=/var/lib/skincos-runtime/github-actions-runner/run.sh
Restart=always
RestartSec=10
TimeoutStopSec=300
# The only privileged transitions are fixed sudoers helper actions. Their
# bounded stdin contracts are validated by root-owned helpers; the runner has
# no general root command, shell, or writable system path.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/skincos-runtime/github-actions-runner
ReadWritePaths=/etc/skincos/global-coordination
ReadWritePaths=/var/lib/skincos/ponto-jit
# Root-only Meta Ads release custody: full workflow checkpoints, the scoped
# maintenance lock, two private lease-proof roots, and only the current-source
# pointer. The unprivileged runner remains blocked by POSIX permissions.
ReadWritePaths=/var/lib/skincos-runtime/orb/exports/workflow-patches
ReadWritePaths=/var/lib/skincos-runtime/orb/state/livia-maintenance
ReadWritePaths=/var/lib/skincos-runtime/global-coordination
ReadWritePaths=/var/lib/skincos-runtime/orb/global-coordination
ReadWritePaths=/opt/skincos/current
UMask=0077

[Install]
WantedBy=multi-user.target
