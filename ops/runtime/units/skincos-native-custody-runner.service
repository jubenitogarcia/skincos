[Unit]
Description=SKINCOS trusted GitHub Actions native custody runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=skincos-actions
Group=skincos-actions
WorkingDirectory=/var/lib/skincos-runtime/github-actions-runner
Environment=HOME=/var/lib/skincos-runtime/github-actions-runner
Environment=RUNNER_ALLOW_RUNASROOT=0
ExecStart=/var/lib/skincos-runtime/github-actions-runner/run.sh
Restart=always
RestartSec=10
TimeoutStopSec=300
# The only privileged transitions are fixed sudoers helper actions. Their
# bounded stdin contracts are validated by root-owned helpers; the runner has
# no general root command, shell, or writable system path.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/skincos-runtime/github-actions-runner
ReadWritePaths=/etc/skincos/global-coordination
ReadWritePaths=/var/lib/skincos/ponto-jit
ReadWritePaths=/var/lib/skincos-runtime/global-coordination
# A fixed, root-owned helper inherits this mount namespace through sudo. These
# are the only additional destinations it needs for the dedicated CRM
# transaction: immutable releases/pointers, its private custody journal and
# the explicit crm.service unit. The runner account itself still has no write
# permission to them and no general sudo command.
ReadWritePaths=/opt/skincos/releases
ReadWritePaths=/opt/skincos/current
ReadWritePaths=/etc/skincos/crm-native-publisher
ReadWritePaths=/var/lib/skincos-runtime/crm-native-publisher
ReadWritePaths=/etc/systemd/system
UMask=0077

[Install]
WantedBy=multi-user.target
