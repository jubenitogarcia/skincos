[Unit]
Description=SKINCOS trusted GitHub Actions native custody runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=skincos-actions
Group=skincos-actions
WorkingDirectory=/var/lib/skincos-runtime/github-actions-runner
Environment=HOME=/var/lib/skincos-runtime/github-actions-runner
Environment=RUNNER_ALLOW_RUNASROOT=0
ExecStart=/var/lib/skincos-runtime/github-actions-runner/run.sh
Restart=always
RestartSec=10
TimeoutStopSec=300
# The only privileged transition is the fixed, argumentless sudoers command
# below. NoNewPrivileges must remain disabled so that this narrowly scoped
# helper can atomically reconcile native custody; the runner still has no
# general root command, shell, or writable system path.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/skincos-runtime/github-actions-runner
ReadWritePaths=/etc/skincos/global-coordination
ReadWritePaths=/var/lib/skincos/ponto-jit
UMask=0077

[Install]
WantedBy=multi-user.target
