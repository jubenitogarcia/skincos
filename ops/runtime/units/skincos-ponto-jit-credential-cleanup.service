[Unit]
Description=SKINCOS Ponto JIT credential expiration cleanup
After=local-fs.target
ConditionPathIsDirectory=/var/lib/skincos/ponto-jit

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/skincos-provision-ponto-jit cleanup-expired
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_DAC_OVERRIDE
ReadWritePaths=/var/lib/skincos/ponto-jit
UMask=0077
