{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bass candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "strategy",
    "compatible_harmony_ids",
    "preview_uri"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "strategy": {
      "type": "string",
      "minLength": 1
    },
    "compatible_harmony_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "preview_uri": {
      "type": "string",
      "minLength": 1
    },
    "midi_uri": {
      "type": "string",
      "minLength": 1
    }
  },
  "examples": [
    {
      "candidate_id": "BAS-1",
      "strategy": "minimal",
      "compatible_harmony_ids": [
        "HAR-1"
      ],
      "preview_uri": "storage://b.wav",
      "midi_uri": "storage://b.mid"
    }
  ],
  "x-invalid-examples": [
    {
      "candidate_id": "BAS-1",
      "strategy": "minimal",
      "compatible_harmony_ids": []
    }
  ]
}
