{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compatibility matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "composition_id",
    "entries",
    "method",
    "evaluated_combinations",
    "pruned_combinations",
    "limits"
  ],
  "properties": {
    "composition_id": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "harmony_id",
          "melody_id",
          "groove_id",
          "bass_id",
          "palette_id",
          "lyric_id",
          "score",
          "dimensions",
          "reasons"
        ],
        "properties": {
          "harmony_id": {
            "type": "string",
            "minLength": 1
          },
          "melody_id": {
            "type": "string",
            "minLength": 1
          },
          "groove_id": {
            "type": "string",
            "minLength": 1
          },
          "bass_id": {
            "type": "string",
            "minLength": 1
          },
          "palette_id": {
            "type": "string",
            "minLength": 1
          },
          "lyric_id": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "dimensions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tonality",
              "scale",
              "melodic_fit",
              "harmonic_rhythm",
              "groove",
              "density",
              "energy",
              "vocal_space",
              "timbre",
              "objective",
              "genre",
              "duration",
              "complexity",
              "originality"
            ],
            "properties": {
              "tonality": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "scale": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "melodic_fit": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "harmonic_rhythm": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "groove": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "density": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "energy": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "vocal_space": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "timbre": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "objective": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "genre": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "duration": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "complexity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "originality": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        }
      },
      "minItems": 1
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "evaluated_combinations": {
      "type": "integer",
      "minimum": 1
    },
    "pruned_combinations": {
      "type": "integer",
      "minimum": 0
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "top_k",
        "beam_width",
        "minimum_score"
      ],
      "properties": {
        "top_k": {
          "type": "integer",
          "minimum": 1
        },
        "beam_width": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  },
  "examples": [
    {
      "composition_id": "CMP-1",
      "entries": [
