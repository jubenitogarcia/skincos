{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Composition DNA",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "composition_dna_id",
    "harmony_id",
    "melody_ids",
    "groove_id",
    "bass_strategy_id",
    "palette_id",
    "compatibility_score"
  ],
  "properties": {
    "composition_dna_id": {
      "type": "string",
      "minLength": 1
    },
    "harmony_id": {
      "type": "string",
      "minLength": 1
    },
    "melody_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "groove_id": {
      "type": "string",
      "minLength": 1
    },
    "bass_strategy_id": {
      "type": "string",
      "minLength": 1
    },
    "palette_id": {
      "type": "string",
      "minLength": 1
    },
    "lyric_concept_id": {
      "type": "string",
      "minLength": 1
    },
    "compatibility_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "examples": [
    {
      "composition_dna_id": "DNA-1",
      "harmony_id": "HAR-1",
      "melody_ids": [
        "MEL-1"
      ],
      "groove_id": "GRV-1",
      "bass_strategy_id": "BAS-1",
      "palette_id": "PAL-1",
      "lyric_concept_id": "LYR-1",
      "compatibility_score": 0.9
    }
  ],
  "x-invalid-examples": [
    {
      "composition_dna_id": "DNA-1",
      "harmony_id": "HAR-1",
      "melody_ids": [],
      "groove_id": "GRV-1",
      "bass_strategy_id": "BAS-1",
      "palette_id": "PAL-1",
      "compatibility_score": 2
    }
  ]
}
