{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lyric candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "concept",
    "lyrics",
    "meter",
    "similarity_risk"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "concept": {
      "type": "string",
      "minLength": 1
    },
    "lyrics": {
      "type": "string",
      "minLength": 1
    },
    "meter": {
      "type": "string",
      "minLength": 1
    },
    "similarity_risk": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "forbidden_words": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "examples": [
    {
      "candidate_id": "LYR-1",
      "concept": "new start",
      "lyrics": "original words",
      "meter": "4/4",
      "similarity_risk": 0.1,
      "forbidden_words": []
    }
  ],
  "x-invalid-examples": [
    {
      "candidate_id": "LYR-1",
      "concept": "x",
      "lyrics": "x",
      "meter": "4/4",
      "similarity_risk": 2
    }
  ]
}
