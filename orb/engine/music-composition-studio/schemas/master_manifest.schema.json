{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Master manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "master_id",
    "composition_id",
    "uri",
    "loudness_lufs",
    "true_peak_db"
  ],
  "properties": {
    "master_id": {
      "type": "string",
      "minLength": 1
    },
    "composition_id": {
      "type": "string",
      "minLength": 1
    },
    "uri": {
      "type": "string",
      "minLength": 1
    },
    "loudness_lufs": {
      "type": "number"
    },
    "true_peak_db": {
      "type": "number"
    },
    "deliverable_uris": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sample_rate": {
      "type": "integer",
      "minimum": 8000
    },
    "bit_depth": {
      "type": "integer",
      "minimum": 8
    }
  },
  "examples": [
    {
      "master_id": "MAS-1",
      "composition_id": "CMP-1",
      "uri": "storage://master.wav",
      "loudness_lufs": -14,
      "true_peak_db": -1,
      "deliverable_uris": [],
      "sample_rate": 44100,
      "bit_depth": 16
    }
  ],
  "x-invalid-examples": [
    {
      "master_id": "MAS-1",
      "composition_id": "CMP-1",
      "uri": "x",
      "loudness_lufs": -14
    }
  ]
}
