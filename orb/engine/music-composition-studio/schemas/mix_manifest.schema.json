{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mix manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mix_id",
    "composition_id",
    "uri",
    "lock_hash",
    "technical_targets",
    "stem_uris"
  ],
  "properties": {
    "mix_id": {
      "type": "string",
      "minLength": 1
    },
    "composition_id": {
      "type": "string",
      "minLength": 1
    },
    "uri": {
      "type": "string",
      "minLength": 1
    },
    "lock_hash": {
      "type": "string",
      "minLength": 1
    },
    "technical_targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "master_lufs",
        "true_peak_db",
        "sample_rate",
        "bit_depth"
      ],
      "properties": {
        "master_lufs": {
          "type": "number"
        },
        "true_peak_db": {
          "type": "number"
        },
        "sample_rate": {
          "type": "integer",
          "minimum": 8000
        },
        "bit_depth": {
          "type": "integer",
          "minimum": 8
        }
      }
    },
    "stem_uris": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "examples": [
    {
      "mix_id": "MIX-1",
      "composition_id": "CMP-1",
      "uri": "storage://mix.wav",
      "lock_hash": "hash",
      "technical_targets": {
        "master_lufs": -14,
        "true_peak_db": -1,
        "sample_rate": 48000,
        "bit_depth": 24
      },
      "stem_uris": [
        "storage://stem.wav"
      ]
    }
  ],
  "x-invalid-examples": [
    {
      "mix_id": "MIX-1",
      "composition_id": "CMP-1",
      "uri": "x",
      "lock_hash": "hash"
    }
  ]
}
