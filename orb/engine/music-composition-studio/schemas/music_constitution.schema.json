{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Music Constitution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "composition_id",
    "revision",
    "lock_hash",
    "purpose",
    "duration_target_seconds",
    "production_tier",
    "tempo",
    "tonality",
    "meter",
    "instrument_palette",
    "reference_rules",
    "forbidden_similarities"
  ],
  "properties": {
    "composition_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "lock_hash": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "use_context": {
      "type": "string",
      "minLength": 1
    },
    "duration_target_seconds": {
      "type": "number",
      "minimum": 1
    },
    "production_tier": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "FAST",
        "STANDARD",
        "PREMIUM"
      ]
    },
    "genre_family": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mood": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tempo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_bpm",
        "allowed_range"
      ],
      "properties": {
        "target_bpm": {
          "type": "number",
          "minimum": 1
        },
        "allowed_range": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      }
    },
    "tonality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preferred_keys",
        "mode",
        "allowed_modulations"
      ],
      "properties": {
        "preferred_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "allowed_modulations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "meter": {
      "type": "string",
      "minLength": 1
    },
    "harmonic_complexity": {
      "type": "string",
      "minLength": 1
    },
    "melodic_character": {
      "type": "string",
      "minLength": 1
    },
    "rhythmic_character": {
      "type": "string",
      "minLength": 1
    },
    "energy_curve": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "instrument_palette": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "vocal_profile": {
      "type": "object"
    },
    "lyrical_constraints": {
      "type": "object"
    },
    "reference_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_similarities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "structure_preferences": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "technical_targets": {
      "type": "object"
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "budget_limits": {
      "type": "object"
    }
  },
  "examples": [
    {
      "composition_id": "CMP-1",
      "revision": 1,
      "lock_hash": "hash",
      "purpose": "video",
      "use_context": "social",
      "duration_target_seconds": 30,
      "production_tier": "FAST",
      "genre_family": [
        "ambient"
      ],
      "mood": [
        "calm"
      ],
      "tempo": {
        "target_bpm": 100,
        "allowed_range": [
          96,
          104
        ]
      },
      "tonality": {
        "preferred_keys": [
          "A minor"
        ],
        "mode": "minor",
        "allowed_modulations": []
      },
      "meter": "4/4",
      "harmonic_complexity": "simple",
      "melodic_character": "memorable",
      "rhythmic_character": "steady",
      "energy_curve": [
        0.2,
        0.8
      ],
      "instrument_palette": [
        "piano"
      ],
      "vocal_profile": {},
      "lyrical_constraints": {},
      "reference_rules": [
        "analyze only"
      ],
      "forbidden_similarities": [
        "recognizable melody"
      ],
      "structure_preferences": [
        "intro",
        "outro"
      ],
      "technical_targets": {},
      "deliverables": [
        "master_wav"
      ],
      "budget_limits": {}
    }
  ],
  "x-invalid-examples": [
    {
      "composition_id": "CMP-1",
      "revision": 1,
      "lock_hash": "hash"
    }
  ]
}
