{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reference analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reference_id",
    "kind",
    "rights_status",
    "analysis",
    "similarity_risk"
  ],
  "properties": {
    "reference_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "rights_status": {
      "type": "string",
      "minLength": 1
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bpm",
        "key",
        "meter",
        "duration_seconds",
        "energy_curve",
        "mix_profile"
      ],
      "properties": {
        "bpm": {
          "type": "number",
          "minimum": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "meter": {
          "type": "string",
          "minLength": 1
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "energy_curve": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "mix_profile": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "similarity_risk": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "examples": [
    {
      "reference_id": "REF-1",
      "kind": "MIX_REFERENCE",
      "rights_status": "LICENSED",
      "analysis": {
        "bpm": 120,
        "key": "A minor",
        "meter": "4/4",
        "duration_seconds": 180,
        "energy_curve": [
          0.2,
          0.8
        ],
        "mix_profile": "wide"
      },
      "similarity_risk": 0.1
    }
  ],
  "x-invalid-examples": [
    {
      "reference_id": "REF-1",
      "kind": "MIX_REFERENCE",
      "rights_status": "LICENSED",
      "analysis": {}
    }
  ]
}
