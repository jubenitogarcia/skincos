{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Song blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "composition_id",
    "composition_dna_id",
    "sections",
    "duration_target_seconds"
  ],
  "properties": {
    "composition_id": {
      "type": "string",
      "minLength": 1
    },
    "composition_dna_id": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Section manifest",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section_id",
          "type",
          "start_bar",
          "bars",
          "duration_seconds",
          "energy",
          "dependencies"
        ],
        "properties": {
          "section_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "start_bar": {
            "type": "integer",
            "minimum": 1
          },
          "bars": {
            "type": "integer",
            "minimum": 1
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0
          },
          "energy": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "harmony_id": {
            "type": "string",
            "minLength": 1
          },
          "melody_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "groove_id": {
            "type": "string",
            "minLength": 1
          },
          "bass_id": {
            "type": "string",
            "minLength": 1
          },
          "instrument_roles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "vocal_plan": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "enabled"
            ],
            "properties": {
              "enabled": {
                "type": "boolean"
              }
            }
          },
          "transition_in": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "transition_out": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "examples": [
          {
            "section_id": "SEC-1",
            "type": "VERSE",
            "start_bar": 1,
            "bars": 8,
            "duration_seconds": 16,
            "energy": 0.4,
            "harmony_id": "HAR-1",
            "melody_ids": [
              "MEL-1"
            ],
            "groove_id": "GRV-1",
            "bass_id": "BAS-1",
            "instrument_roles": [
              "piano"
            ],
            "vocal_plan": {
              "enabled": false
            },
            "transition_in": {
              "type": "fade-in"
            },
            "transition_out": {
              "type": "continuity"
            },
            "dependencies": []
          }
        ],
        "x-invalid-examples": [
          {
            "section_id": "SEC-1",
            "type": "VERSE",
            "start_bar": 0,
            "bars": 0,
            "duration_seconds": 0,
            "energy": 2,
            "dependencies": []
          }
        ]
      },
      "minItems": 1
    },
    "duration_target_seconds": {
      "type": "number",
      "minimum": 1
    },
    "energy_curve": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 1
    }
  },
  "examples": [
    {
      "composition_id": "CMP-1",
      "composition_dna_id": "DNA-1",
      "sections": [
        {
          "section_id": "SEC-1",
          "type": "VERSE",
          "start_bar": 1,
          "bars": 8,
          "duration_seconds": 16,
          "energy": 0.4,
          "harmony_id": "HAR-1",
          "melody_ids": [
            "MEL-1"
          ],
          "groove_id": "GRV-1",
          "bass_id": "BAS-1",
          "instrument_roles": [
            "piano"
          ],
          "vocal_plan": {
            "enabled": false
          },
          "transition_in": {
            "type": "fade-in"
          },
          "transition_out": {
            "type": "continuity"
          },
          "dependencies": []
        }
      ],
      "duration_target_seconds": 30,
      "energy_curve": [
        0.2,
        0.8
      ]
    }
  ],
  "x-invalid-examples": [
    {
      "composition_id": "CMP-1",
      "composition_dna_id": "DNA-1",
      "sections": [],
      "duration_target_seconds": 0
    }
  ]
}
