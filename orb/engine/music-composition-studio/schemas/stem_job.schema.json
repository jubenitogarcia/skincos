{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stem job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stem_job_id",
    "composition_id",
    "section_id",
    "stem_role",
    "instrument",
    "key",
    "bpm",
    "meter",
    "status"
  ],
  "properties": {
    "stem_job_id": {
      "type": "string",
      "minLength": 1
    },
    "composition_id": {
      "type": "string",
      "minLength": 1
    },
    "composition_dna_id": {
      "type": "string",
      "minLength": 1
    },
    "section_id": {
      "type": "string",
      "minLength": 1
    },
    "stem_role": {
      "type": "string",
      "minLength": 1
    },
    "instrument": {
      "type": "string",
      "minLength": 1
    },
    "key": {
      "type": "string",
      "minLength": 1
    },
    "scale": {
      "type": "string",
      "minLength": 1
    },
    "bpm": {
      "type": "number",
      "minimum": 1
    },
    "meter": {
      "type": "string",
      "minLength": 1
    },
    "bars": {
      "type": "integer",
      "minimum": 1
    },
    "start_bar": {
      "type": "integer",
      "minimum": 1
    },
    "midi_input_url": {
      "type": "string",
      "minLength": 1
    },
    "audio_reference_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "variation_index": {
      "type": "integer",
      "minimum": 1
    },
    "priority": {
      "type": "number"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    }
  },
  "examples": [
    {
      "stem_job_id": "STEM-1",
      "composition_id": "CMP-1",
      "composition_dna_id": "DNA-1",
      "section_id": "SEC-1",
      "stem_role": "DRUMS",
      "instrument": "kit",
      "key": "A",
      "scale": "minor",
      "bpm": 100,
      "meter": "4/4",
      "bars": 8,
      "start_bar": 1,
      "midi_input_url": "storage://m.mid",
      "audio_reference_urls": [],
      "variation_index": 1,
      "priority": 1,
      "dependencies": [],
      "provider": "mock",
      "status": "QUEUED"
    }
  ],
  "x-invalid-examples": [
    {
      "stem_job_id": "STEM-1",
      "composition_id": "CMP-1",
      "section_id": "SEC-1",
      "stem_role": "DRUMS",
      "instrument": "kit",
      "key": "A",
      "bpm": 0,
      "meter": "4/4",
      "status": "QUEUED"
    }
  ]
}
