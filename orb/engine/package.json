{
    "name": "@skincos/orb-engine",
    "version": "1.0.0",
    "description": "SKINCOS Orb workflow engine and native runtime operations",
    "main": "workflow-assistant.js",
    "scripts": {
        "list": "node workflow-assistant.js list",
        "show": "node workflow-assistant.js show",
        "export": "node workflow-assistant.js export",
        "import": "node workflow-assistant.js import",
        "debug-bundle": "node workflow-assistant.js debug-bundle",
        "workflow:meta-ads-report:sync": "node scripts/sync-meta-ads-performance-report-workflow.js",
        "workflow:campaign-creative:build": "node scripts/build-campaign-creative-generator.js",
        "workflow:campaign-creative:validate": "node scripts/validate-campaign-creative-generator.js",
        "cf:meta-ads-report:deploy": "wrangler deploy -c cloudflare/meta-ads-performance-report/wrangler.jsonc",
        "cf:meta-ads-report:deploy:staging": "wrangler deploy -c cloudflare/meta-ads-performance-report/wrangler.jsonc --env staging",
        "cf:meta-ads-report:migrate": "wrangler d1 execute skincos-meta-ads-performance-report --remote --file cloudflare/d1/migrations/0001_meta_ads_performance_report.sql",
        "cf:meta-ads-report:migrate:staging": "wrangler d1 execute skincos-meta-ads-performance-report-staging --remote --file cloudflare/d1/migrations/0001_meta_ads_performance_report.sql",
        "cf:meta-ads-report:tail": "wrangler tail -c cloudflare/meta-ads-performance-report/wrangler.jsonc",
        "service:status": "bash ../../scripts/runtime/manage-native-runtime.sh status",
        "service:restart": "bash ../../scripts/runtime/manage-native-runtime.sh restart",
        "service:logs": "bash ../../scripts/runtime/manage-native-runtime.sh logs",
        "service:validate": "bash ../../scripts/runtime/manage-native-runtime.sh validate",
        "service:validate:business": "bash scripts/validate-mini-pc-business-readiness.sh",
        "service:audit-live-runtime-paths": "sudo -n -u postgres N8N_ROOT=${N8N_ROOT:-/opt/skincos/current/source/orb/engine} N8N_RUNTIME_HOME=${N8N_RUNTIME_HOME:-/var/lib/skincos-runtime/orb} N8N_TMP_DIR=${N8N_TMP_DIR:-/tmp} node scripts/audit-n8n-live-runtime-paths.js",
        "service:audit-executions": "node scripts/audit-execution-persistence.js",
        "service:audit-execution-secrets": "sudo -n -u postgres node scripts/sanitize-execution-history.js",
        "service:sanitize-execution-history": "sudo -n -u postgres node scripts/sanitize-execution-history.js --apply",
        "service:configure-execution-persistence": "sudo -n -u postgres N8N_RUNTIME_HOME=${N8N_RUNTIME_HOME:-/var/lib/skincos-runtime/orb} node scripts/configure-execution-persistence.js --apply",
        "service:repair-postgres-invariants": "sudo -n -u postgres N8N_RUNTIME_HOME=${N8N_RUNTIME_HOME:-/var/lib/skincos-runtime/orb} node scripts/repair-postgres-runtime-invariants.js --apply",
        "service:configure-observability": "bash scripts/configure-runtime-observability.sh",
        "mcp:readonly:test": "node --test mcp-readonly-gateway/tests/*.test.mjs",
        "mcp:readonly:validate": "node mcp-readonly-gateway/scripts/validate-architecture.mjs",
        "mcp:readonly:status": "bash mcp-readonly-gateway/scripts/status-runtime.sh",
        "mcp:readonly:install": "sudo bash mcp-readonly-gateway/scripts/install-runtime.sh",
        "mcp:readonly:rollback": "sudo bash mcp-readonly-gateway/scripts/rollback-runtime.sh",
        "mcp:readonly:snapshot": "node mcp-readonly-gateway/scripts/build-snapshot-index.mjs",
        "service:backup": "sudo -n bash scripts/backup-n8n.sh",
        "livia:qa:inspect": "node scripts/livia/qa-runner.js inspect",
        "livia:qa:audit": "node scripts/livia/qa-runner.js audit",
        "livia:qa:validate": "node scripts/livia/qa-runner.js validate",
        "livia:qa:replay-process-media": "node scripts/livia/qa-runner.js replay-process-media",
        "livia:qa:replay-build-graph": "node scripts/livia/qa-runner.js replay-build-graph",
        "livia:qa:retry": "node scripts/livia/qa-runner.js retry",
        "livia:qa:restore-progress": "node scripts/livia/qa-runner.js restore-progress",
        "livia:qa:latest": "node scripts/livia/qa-runner.js latest",
        "livia:secrets:scan": "node scripts/livia/sanitize-workflow-exports.js",
        "livia:secrets:sanitize": "node scripts/livia/sanitize-workflow-exports.js --apply"
    },
    "keywords": [
        "orb",
        "workflow",
        "automation"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "better-sqlite3": "^11.7.0",
        "http-proxy": "^1.18.1"
    }
}
