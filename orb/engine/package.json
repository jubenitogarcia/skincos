{
    "name": "@skincos/orb-engine",
    "version": "1.0.0",
    "description": "SKINCOS Orb workflow engine and native runtime operations",
    "main": "workflow-assistant.js",
    "scripts": {
        "test": "node tests/music-composition-studio.test.js && node --test tests/campaign-creative-executor.test.js",
        "lint": "node --check music-composition-studio/pipeline.js && node --check music-composition-studio/adapters.js && node --check music-composition-studio/error-handler.js && node --check music-composition-studio/lib/canonical.js && node --check music-composition-studio/lib/compatibility.js && node --check music-composition-studio/lib/contracts.js && node --check music-composition-studio/lib/invalidation.js && node --check music-composition-studio/lib/ledger.js && node --check music-composition-studio/lib/providers.js && node --check music-composition-studio/lib/schema-definitions.js && node --check music-composition-studio/services/audio-service.js && node --check campaign-creative-executor/contracts.js && node --check campaign-creative-executor/storage.js && node --check campaign-creative-executor/store.js && node --check campaign-creative-executor/adapters/renderer.js && node --check campaign-creative-executor/adapters/mock.js && node --check campaign-creative-executor/adapters/openai-images.js && node --check campaign-creative-executor/adapters/storage.js && node --check campaign-creative-executor/registry.js && node --check campaign-creative-executor/executor.js && node --check campaign-creative-executor/server.js && node --check campaign-creative-executor/index.js && node --check scripts/build-music-composition-studio.js && node --check scripts/dry-run-music-composition-studio.js && node --check scripts/generate-music-composition-studio-fixtures.js && node --check scripts/generate-music-composition-studio-schemas.js && node --check scripts/validate-music-composition-studio.js && node --check scripts/build-campaign-creative-creator-continuous.js && node --check scripts/validate-campaign-creative-creator-continuous.js && node --check scripts/build-campaign-creative-creator-organizer.js && node --check tests/campaign-creative-creator-continuous.test.js && node --check tests/campaign-creative-executor.test.js && bash -n scripts/validate-music-composition-studio-migration.sh && bash -n scripts/validate-music-composition-studio-n8n-import.sh",
        "workflow:music:schemas": "node scripts/generate-music-composition-studio-schemas.js",
        "workflow:music:fixtures": "node scripts/generate-music-composition-studio-fixtures.js",
        "workflow:music:build": "node scripts/generate-music-composition-studio-schemas.js && node scripts/generate-music-composition-studio-fixtures.js && node scripts/build-music-composition-studio.js",
        "workflow:music:validate": "node scripts/validate-music-composition-studio.js",
        "workflow:music:test": "node tests/music-composition-studio.test.js",
        "workflow:music:dry-run": "node scripts/dry-run-music-composition-studio.js",
        "workflow:music:migration-test": "bash scripts/validate-music-composition-studio-migration.sh",
        "workflow:music:n8n-import-test": "bash scripts/validate-music-composition-studio-n8n-import.sh",
        "workflow:music:verify": "npm run workflow:music:build && npm run workflow:music:validate && npm run workflow:music:test && npm run workflow:music:dry-run && npm run lint && npm run workflow:music:migration-test && npm run workflow:music:n8n-import-test",
        "list": "node workflow-assistant.js list",
        "show": "node workflow-assistant.js show",
        "export": "node workflow-assistant.js export",
        "import": "node workflow-assistant.js import",
        "debug-bundle": "node workflow-assistant.js debug-bundle",
        "workflow:meta-ads-report:sync": "node scripts/sync-meta-ads-performance-report-workflow.js",
        "workflow:campaign-creative:build": "node scripts/build-campaign-creative-generator.js",
        "workflow:campaign-creative:validate": "node scripts/validate-campaign-creative-generator.js",
        "workflow:campaign-creative:continuous:build": "node scripts/build-campaign-creative-creator-continuous.js",
        "workflow:campaign-creative:continuous:validate": "node scripts/validate-campaign-creative-creator-continuous.js",
        "workflow:campaign-creative:continuous:test": "node tests/campaign-creative-creator-continuous.test.js",
        "workflow:campaign-creative:executor:test": "node --test tests/campaign-creative-executor.test.js",
        "workflow:campaign-creative:executor:serve": "node campaign-creative-executor/server.js",
        "cf:meta-ads-report:deploy": "wrangler deploy -c cloudflare/meta-ads-performance-report/wrangler.jsonc",
        "cf:meta-ads-report:deploy:staging": "wrangler deploy -c cloudflare/meta-ads-performance-report/wrangler.jsonc --env staging",
        "cf:meta-ads-report:migrate": "wrangler d1 execute skincos-meta-ads-performance-report --remote --file cloudflare/d1/migrations/0001_meta_ads_performance_report.sql",
        "cf:meta-ads-report:migrate:staging": "wrangler d1 execute skincos-meta-ads-performance-report-staging --remote --file cloudflare/d1/migrations/0001_meta_ads_performance_report.sql",
        "cf:meta-ads-report:tail": "wrangler tail -c cloudflare/meta-ads-performance-report/wrangler.jsonc",
        "service:status": "bash ../../scripts/runtime/manage-native-runtime.sh status",
        "service:restart": "bash ../../scripts/runtime/manage-native-runtime.sh restart",
        "service:logs": "bash ../../scripts/runtime/manage-native-runtime.sh logs",
        "service:validate": "bash ../../scripts/runtime/manage-native-runtime.sh validate",
        "service:validate:business": "bash scripts/validate-mini-pc-business-readiness.sh",
        "service:audit-live-runtime-paths": "sudo -n -u postgres N8N_ROOT=${N8N_ROOT:-/opt/skincos/current/source/orb/engine} N8N_RUNTIME_HOME=${N8N_RUNTIME_HOME:-/var/lib/skincos-runtime/orb} N8N_TMP_DIR=${N8N_TMP_DIR:-/tmp} node scripts/audit-n8n-live-runtime-paths.js",
        "service:audit-executions": "node scripts/audit-execution-persistence.js",
        "service:audit-execution-secrets": "sudo -n -u postgres node scripts/sanitize-execution-history.js",
        "service:sanitize-execution-history": "sudo -n -u postgres node scripts/sanitize-execution-history.js --apply",
        "service:configure-execution-persistence": "sudo -n -u postgres N8N_RUNTIME_HOME=${N8N_RUNTIME_HOME:-/var/lib/skincos-runtime/orb} node scripts/configure-execution-persistence.js --apply",
        "service:repair-postgres-invariants": "sudo -n -u postgres N8N_RUNTIME_HOME=${N8N_RUNTIME_HOME:-/var/lib/skincos-runtime/orb} node scripts/repair-postgres-runtime-invariants.js --apply",
        "service:configure-observability": "bash scripts/configure-runtime-observability.sh",
        "mcp:readonly:test": "node --test mcp-readonly-gateway/tests/*.test.mjs",
        "mcp:readonly:validate": "node mcp-readonly-gateway/scripts/validate-architecture.mjs",
        "mcp:readonly:status": "bash mcp-readonly-gateway/scripts/status-runtime.sh",
        "mcp:readonly:install": "sudo bash mcp-readonly-gateway/scripts/install-runtime.sh",
        "mcp:readonly:rollback": "sudo bash mcp-readonly-gateway/scripts/rollback-runtime.sh",
        "mcp:readonly:snapshot": "node mcp-readonly-gateway/scripts/build-snapshot-index.mjs",
        "service:backup": "sudo -n bash scripts/backup-n8n.sh",
        "livia:qa:inspect": "node scripts/livia/qa-runner.js inspect",
        "livia:qa:audit": "node scripts/livia/qa-runner.js audit",
        "livia:qa:test": "node --test tests/livia-qa-runner.test.js tests/livia-validate-publish-token-health.test.js tests/livia-token-vault-preflight-patch.test.js tests/livia-drive-publication-marks.test.js tests/livia-accessibility-contract.test.js tests/livia-production-candidate.test.js && bash scripts/test-livia-qa-runner-safety.sh",
        "livia:qa:validate": "node scripts/livia/qa-runner.js validate",
        "livia:qa:replay-process-media": "node scripts/livia/qa-runner.js replay-process-media",
        "livia:qa:replay-build-graph": "node scripts/livia/qa-runner.js replay-build-graph",
        "livia:qa:retry": "node scripts/livia/qa-runner.js retry",
        "livia:qa:restore-progress": "node scripts/livia/qa-runner.js restore-progress",
        "livia:qa:latest": "node scripts/livia/qa-runner.js latest",
        "livia:secrets:scan": "node scripts/livia/sanitize-workflow-exports.js",
        "livia:secrets:sanitize": "node scripts/livia/sanitize-workflow-exports.js --apply"
    },
    "keywords": [
        "orb",
        "workflow",
        "automation"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "better-sqlite3": "^11.7.0",
        "http-proxy": "^1.18.1"
    }
}
