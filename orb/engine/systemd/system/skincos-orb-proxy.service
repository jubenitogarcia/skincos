[Unit]
Description=Skincos orb proxy shared runtime
After=skincos-n8n.service
Wants=skincos-n8n.service

[Service]
Type=simple
User=skincos
Group=skincos
WorkingDirectory=__N8N_ROOT__
Environment=N8N_ROOT=__N8N_ROOT__
Environment=N8N_RUNTIME_HOME=__N8N_RUNTIME_HOME__
Environment=N8N_ENV_FILE=__N8N_ENV_FILE__
Environment=N8N_BUSINESS_ENV_FILE=__N8N_BUSINESS_ENV_FILE__
Environment=N8N_LOG_DIR=__N8N_LOG_DIR__
Environment=N8N_TMP_DIR=__N8N_TMP_DIR__
Environment=META_REVIEW_STORE_PATH=__N8N_TMP_DIR__/meta-review-store.json
EnvironmentFile=-__N8N_ENV_FILE__
EnvironmentFile=-__N8N_BUSINESS_ENV_FILE__
ExecStart=/usr/bin/node orb-proxy/server.js
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__N8N_RUNTIME_HOME__
UMask=0027
StandardOutput=append:__N8N_LOG_DIR__/system-orb-proxy.out.log
StandardError=append:__N8N_LOG_DIR__/system-orb-proxy.err.log

[Install]
WantedBy=multi-user.target
