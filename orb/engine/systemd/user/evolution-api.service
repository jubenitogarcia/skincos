[Unit]
Description=Skincos Evolution API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__N8N_ROOT__/evolution-api
Environment=NVM_DIR=%h/.nvm
Environment=N8N_ROOT=__N8N_ROOT__
Environment=N8N_RUNTIME_HOME=__N8N_RUNTIME_HOME__
Environment=EVOLUTION_API_ENV_FILE=__EVOLUTION_ENV_FILE__
Environment=EVOLUTION_API_INSTANCES_DIR=__EVOLUTION_INSTANCES_DIR__
Environment=EVOLUTION_API_STORE_DIR=__EVOLUTION_STORE_DIR__
Environment=N8N_LOG_DIR=__N8N_LOG_DIR__
ExecStart=/bin/bash -lc 'source "$HOME/.nvm/nvm.sh"; nvm use 20 >/dev/null; exec ./start-evolution-api.sh'
Restart=always
RestartSec=10
StandardOutput=append:__N8N_LOG_DIR__/evolution-api.log
StandardError=append:__N8N_LOG_DIR__/evolution-api.error.log

[Install]
WantedBy=default.target
