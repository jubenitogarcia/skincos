# Shared-workspace note:
# - Copy to a private `.dev.vars` outside the shared area when possible.
# - Never commit or store real values under `C:\CodexShared`.
# - Keep only variable names and safe acquisition notes in this repository.
#
# Copie para .dev.vars (não commitar) para usar em preview local via Wrangler/OpenNext

# Opcional: links assinados para confirmar/recusar via WhatsApp/webhook (recomendado)
# Obtenha com o responsável operacional do website / booking.
BOOKING_DECISION_SECRET=
# Opcional: token assinado para polling de status do agendamento (fallback: BOOKING_DECISION_SECRET)
BOOKING_STATUS_SECRET=
# Opcional: segredo para lock server-side da roleta /cadastro
CADASTRO_WHEEL_SECRET=
# Opcional: janela de lock da roleta em horas (default: 24, máximo: 168)
CADASTRO_WHEEL_LOCK_HOURS=

# Opcional: webhook para automação (ex.: seu serviço que envia WhatsApp)
BOOKING_WEBHOOK_URL=
BOOKING_WEBHOOK_SECRET=

# Opcional: envio de confirmação por e-mail
# Use uma das opções abaixo:
# 1) Titan SMTP por unidade
BOOKING_EMAIL_FROM=
TITAN_SMTP_HOST=smtp.titan.email
TITAN_SMTP_PORT=465
TITAN_SMTP_USER_BARRA=
TITAN_SMTP_PASS_BARRA=
TITAN_SMTP_USER_NH=
TITAN_SMTP_PASS_NH=
# 2) Resend
# Obtenha no provedor de e-mail aprovado para este ambiente.
RESEND_API_KEY=
# 3) Webhook próprio
BOOKING_EMAIL_WEBHOOK_URL=
BOOKING_EMAIL_WEBHOOK_SECRET=

# Opcional: envio de confirmação por WhatsApp via webhook próprio
BOOKING_WHATSAPP_WEBHOOK_URL=
BOOKING_WHATSAPP_WEBHOOK_SECRET=

# Opcional: customização visual da confirmação
BOOKING_EMAIL_LOGO_URL=
BOOKING_EMAIL_AMBASSADOR_MALE_IMAGE_URL=
BOOKING_EMAIL_AMBASSADOR_FEMALE_IMAGE_URL=

# Opcional: token de autenticação da agenda (usado em /api/agenda e smoke estrito)
AGENDA_SYNC_TOKEN=
# Opcional: override dedicado do smoke (se vazio, usa AGENDA_SYNC_TOKEN)
SMOKE_AGENDA_TOKEN=

# Opcional: Cloudflare Turnstile (anti-bot) para o formulário de agendamento
# - Site key: public (vai para o bundle)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# - Secret key: server-side (configure como Worker secret em produção)
TURNSTILE_SECRET_KEY=
# Opcional: controle explícito do fail-closed do Turnstile
BOOKING_REQUIRE_TURNSTILE=
