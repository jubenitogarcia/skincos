{
  "name": "espacofacial-open",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next build >/dev/null && tsc -p tsconfig.json --noEmit --incremental false",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "smoke:strict": "SMOKE_REQUIRE_AGENDA=1 node scripts/smoke.mjs",
    "tracking:governance": "node scripts/audit-tracking-governance.mjs",
    "quality:pr": "npm run audit:360:ci",
    "quality:check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run smoke",
    "quality:ci": "npm ci && npm run quality:check",
    "test:agenda": "tsx --test tests/agendaDb.test.ts",
    "audit:360": "node scripts/audit360.mjs",
    "audit:360:ci": "npm ci && npm run audit:360",
    "cf:security": "node scripts/cloudflare-sync-security.mjs",
    "cf:security:check": "node scripts/cloudflare-sync-security.mjs --check",
    "sync:online:snapshot": "node scripts/sync-online-snapshot.mjs",
    "tail": "wrangler tail espacofacial-site --format pretty --sampling-rate 0.25",
    "tail:skincos": "wrangler tail skincos-site --format pretty --sampling-rate 0.25",
    "tail:json": "wrangler tail espacofacial-site --format json",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "preview:snapshot": "npm run sync:online:snapshot && npm run preview",
    "deploy": "npm ci && node scripts/deploy-worker.mjs",
    "deploy:skincos": "npm ci && node scripts/deploy-worker.mjs --config wrangler-skincos.toml",
    "deploy:esfa": "wrangler deploy -c workers/esfa-redirector/wrangler.toml"
  },
  "dependencies": {
    "@svg-maps/brazil": "^2.0.0",
    "next": "^15.5.18",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/eslintrc": "^3.3.5",
    "@opennextjs/cloudflare": "^1.19.11",
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "cheerio": "^1.1.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.18",
    "lighthouse": "^13.0.3",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.56.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.22.4",
    "typescript": "5.5.4",
    "wrangler": "^4.100.0"
  },
  "overrides": {
    "basic-ftp": "6.0.1",
    "brace-expansion@<1.1.13": "1.1.13",
    "brace-expansion@>=2.0.0 <2.0.3": "2.0.3",
    "brace-expansion@>=4.0.0 <5.0.6": "5.0.6",
    "brace-expansion@>=5.0.0 <5.0.6": "5.0.6",
    "esbuild": "0.28.1",
    "fast-xml-parser": "5.9.0",
    "form-data": "4.0.6",
    "ip-address": "10.2.0",
    "js-yaml": "4.2.0",
    "postcss": "8.5.15",
    "qs": "6.15.2",
    "ws": "8.21.0",
    "wrangler": {
      "undici": "7.24.8"
    },
    "encoding-sniffer": "1.0.2",
    "formdata-node": "6.0.3"
  }
}
