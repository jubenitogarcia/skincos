{
  "name": "@skincos/ponto-pages",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify:surface": "node scripts/verify-surface.mjs",
    "fetch-face-models": "node scripts/fetch-face-models.mjs",
    "check": "npm run verify:surface && npm run test && npm run build",
    "deploy:check": "node scripts/assert-deploy-intent.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-slot": "1.1.2",
    "@tensorflow/tfjs": "4.22.0",
    "@vladmandic/face-api": "1.7.15",
    "class-variance-authority": "0.7.1",
    "lucide-react": "0.484.0",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sonner": "2.0.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260804.1",
    "@types/node": "22.20.2",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.3",
    "@tailwindcss/vite": "4.3.1",
    "tailwindcss": "4.2.0",
    "typescript": "5.7.2",
    "vite": "8.0.16",
    "vitest": "4.1.11"
  }
}
